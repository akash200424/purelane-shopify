{%- comment -%}
  Purelane brand icons.

  Usage:
    {% render 'icon', name: 'leaf' %}
    {% render 'icon', name: 'shield-check' %}
    {% render 'icon', name: 'no-chemicals' %}
    {% render 'icon', name: 'drop' %}
    {% render 'icon', name: 'recycle' %}
{%- endcomment -%}

{%- case name -%}

  {%- when 'leaf' -%}

    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      focusable="false"
    >
      <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
      <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
    </svg>


  {%- when 'shield-check' -%}

    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      focusable="false"
    >
      <path d="M12 3 4.5 6v6.2c0 4.3 3.1 7.6 7.5 8.8 4.4-1.2 7.5-4.5 7.5-8.8V6L12 3Z"/>
      <path d="m9 12 2.2 2.2L15.4 10"/>
    </svg>


  {%- when 'no-chemicals' -%}

    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      focusable="false"
    >
      <circle
        cx="12"
        cy="12"
        r="8.4"
      />

      <path d="M6.4 17.6 17.6 6.4"/>
    </svg>


  {%- when 'drop' -%}

    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      focusable="false"
    >
      <path d="M12 3c3.6 4.6 6.5 8.4 6.5 11.5A6.5 6.5 0 1 1 5.5 14.5C5.5 11.4 8.4 7.6 12 3Z"/>
    </svg>


  {%- when 'recycle' -%}

    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      focusable="false"
    >
      <path d="m7 19-3-5 3-5"/>
      <path d="m17 5 3 5-3 5"/>
      <path d="M4 14h16"/>
    </svg>


{%- endcase -%}