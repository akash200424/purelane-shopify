<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    >

    <meta
      name="theme-color"
      content="#f4f0fb"
    >

    <title>
      {{ page_title }}
      {% if current_tags %}
        – {{ current_tags | join: ', ' }}
      {% endif %}
      {% if current_page != 1 %}
        – Page {{ current_page }}
      {% endif %}
      {% unless page_title contains shop.name %}
        – {{ shop.name }}
      {% endunless %}
    </title>

    {% if page_description %}
      <meta
        name="description"
        content="{{ page_description | escape }}"
      >
    {% endif %}

    {{ content_for_header }}

    {{ 'purelane.css' | asset_url | stylesheet_tag }}

    <script
      src="{{ 'purelane.js' | asset_url }}"
      defer="defer"
    ></script>
  </head>

  <body>

    {{ content_for_layout }}

  </body>
</html>