{%- comment -%}
  PURELANE HERO
  - Dynamic image slides
  - Images uploaded from Theme Editor
  - Automatic animation
  - Swipe / drag support
  - Dynamic price tag
  - Plant Powered
  - Safe for Kids & Pets
  - Zero Harsh Chemicals
  - No hardcoded product images
{%- endcomment -%}

<style>
/* =========================================================
   PURELANE HERO
   ========================================================= */

#purelane-hero-{{ section.id }} {
  --navy: #15112f;
  --green: #006f63;
  --orange: #c77a0b;
  --text: #53566d;
  --mint: #dff5e9;

  position: relative;
  min-height: 760px;
  overflow: hidden;
}

/* background */
#purelane-hero-{{ section.id }} .purelane-hero-bg {
  position: absolute;
  inset: 0;
  background:
    radial-gradient(
      circle at 72% 45%,
      rgba(255,255,255,.96) 0%,
      rgba(239,252,245,.88) 30%,
      rgba(207,241,222,.82) 68%,
      rgba(190,231,211,.9) 100%
    );
  z-index: 0;
}

/* subtle organic background */
#purelane-hero-{{ section.id }} .purelane-wave {
  position: absolute;
  inset: 0;
  pointer-events: none;
  opacity: .35;
  z-index: 1;
}

#purelane-hero-{{ section.id }} .purelane-wave::before,
#purelane-hero-{{ section.id }} .purelane-wave::after {
  content: "";
  position: absolute;
  left: -5%;
  width: 110%;
  height: 120px;
  border-top: 2px solid rgba(255,255,255,.65);
  border-radius: 50%;
  transform: rotate(-3deg);
}

#purelane-hero-{{ section.id }} .purelane-wave::before {
  top: 25%;
}

#purelane-hero-{{ section.id }} .purelane-wave::after {
  top: 65%;
  transform: rotate(2deg);
}

/* =========================================================
   MAIN
   ========================================================= */

#purelane-hero-{{ section.id }} .purelane-hero-inner {
  position: relative;
  z-index: 5;

  width: min(1180px, calc(100% - 80px));
  min-height: 760px;
  margin: 0 auto;

  display: grid;
  grid-template-columns: 46% 54%;
  align-items: center;
}

/* =========================================================
   LEFT
   ========================================================= */

#purelane-hero-{{ section.id }} .purelane-copy {
  position: relative;
  z-index: 20;
  padding-top: 40px;
}

#purelane-hero-{{ section.id }} .purelane-heading {
  margin: 0;
  color: var(--navy);

  font-size: clamp(70px, 7vw, 112px);
  line-height: .86;
  letter-spacing: -.065em;
  font-weight: 900;
  text-transform: uppercase;
}

#purelane-hero-{{ section.id }} .purelane-heading .highlight {
  color: var(--orange);
}

#purelane-hero-{{ section.id }} .purelane-divider {
  width: 360px;
  max-width: 100%;
  margin: 30px 0 22px;

  display: flex;
  align-items: center;
  gap: 12px;
}

#purelane-hero-{{ section.id }} .purelane-divider-line {
  height: 1px;
  flex: 1;
  background: rgba(0,111,99,.28);
}

#purelane-hero-{{ section.id }} .purelane-divider-leaf {
  width: 18px;
  height: 18px;
  color: var(--orange);
  display: flex;
  align-items: center;
  justify-content: center;
}

#purelane-hero-{{ section.id }} .purelane-description {
  max-width: 470px;
  margin-bottom: 28px;

  color: var(--text);
  font-size: 18px;
  line-height: 1.55;
}

/* =========================================================
   BUTTONS
   ========================================================= */

#purelane-hero-{{ section.id }} .purelane-buttons {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
}

#purelane-hero-{{ section.id }} .purelane-button {
  min-height: 50px;
  padding: 0 25px;

  border-radius: 30px;

  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;

  text-decoration: none;

  font-size: 13px;
  font-weight: 800;
  letter-spacing: .12em;

  transition:
    transform .25s ease,
    box-shadow .25s ease,
    background .25s ease;
}

/* WHITE SHOP NOW */
#purelane-hero-{{ section.id }} .purelane-button-primary {
  background: #fff;
  color: var(--green);

  border: 1px solid rgba(0,111,99,.08);

  box-shadow:
    0 12px 30px rgba(0,80,65,.10);
}

#purelane-hero-{{ section.id }} .purelane-button-primary:hover {
  background: #fff;
  color: var(--green);
  transform: translateY(-2px);

  box-shadow:
    0 16px 35px rgba(0,80,65,.16);
}

#purelane-hero-{{ section.id }} .purelane-button-secondary {
  background: rgba(255,255,255,.72);
  color: var(--green);

  border: 1px solid rgba(0,111,99,.18);
}

#purelane-hero-{{ section.id }} .purelane-button-secondary:hover {
  background: #fff;
  transform: translateY(-2px);
}

/* =========================================================
   RIGHT IMAGE AREA
   ========================================================= */

#purelane-hero-{{ section.id }} .purelane-visual {
  position: relative;
  width: 100%;
  height: 680px;

  display: flex;
  align-items: center;
  justify-content: center;

  touch-action: pan-y;
}

/* =========================================================
   SLIDES
   ========================================================= */

#purelane-hero-{{ section.id }} .purelane-slide {
  position: absolute;
  inset: 0;

  display: flex;
  align-items: center;
  justify-content: center;

  opacity: 0;
  visibility: hidden;
  pointer-events: none;

  transition:
    opacity .6s ease,
    visibility .6s ease;
}

#purelane-hero-{{ section.id }} .purelane-slide.active {
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
}

/* =========================================================
   IMAGE
   ========================================================= */

#purelane-hero-{{ section.id }} .purelane-image-wrap {
  position: relative;

  width: 430px;
  height: 560px;

  display: flex;
  align-items: center;
  justify-content: center;
}

#purelane-hero-{{ section.id }} .purelane-image-wrap::before {
  content: "";

  position: absolute;

  width: 360px;
  height: 360px;

  border-radius: 50%;

  background:
    radial-gradient(
      circle,
      rgba(255,255,255,.95),
      rgba(255,255,255,.4) 55%,
      transparent 72%
    );

  filter: blur(8px);

  z-index: 0;
}

#purelane-hero-{{ section.id }} .purelane-image {
  position: relative;
  z-index: 2;

  width: auto;
  max-width: 100%;
  height: auto;

  max-height: 530px;

  object-fit: contain;

  filter:
    drop-shadow(0 30px 30px rgba(30,70,60,.20));

  opacity: 0;

  transform:
    translateY(80px)
    scale(.86);
}

/* ENTER ANIMATION */
#purelane-hero-{{ section.id }} .purelane-slide.active .purelane-image {
  animation:
    purelaneImageEnter
    .9s
    cubic-bezier(.16,1,.3,1)
    .08s
    forwards,

    purelaneImageFloat
    4s
    ease-in-out
    1s
    infinite;
}

@keyframes purelaneImageEnter {
  0% {
    opacity: 0;
    transform:
      translateY(80px)
      scale(.86);
  }

  100% {
    opacity: 1;
    transform:
      translateY(0)
      scale(1);
  }
}

@keyframes purelaneImageFloat {
  0%,
  100% {
    transform: translateY(0);
  }

  50% {
    transform: translateY(-13px);
  }
}

/* =========================================================
   EMPTY IMAGE
   ========================================================= */

#purelane-hero-{{ section.id }} .purelane-empty-image {
  width: 300px;
  height: 400px;

  border-radius: 30px;

  background: rgba(255,255,255,.45);

  border: 1px dashed rgba(0,111,99,.25);

  display: flex;
  align-items: center;
  justify-content: center;

  color: rgba(20,20,50,.35);

  text-align: center;
  padding: 30px;

  font-size: 13px;
  font-weight: 700;
}

/* =========================================================
   PRICE TAG
   ========================================================= */

#purelane-hero-{{ section.id }} .purelane-price {
  position: absolute;

  left: 7%;
  bottom: 105px;

  z-index: 10;

  width: 145px;
  min-height: 100px;

  padding: 17px;

  border-radius: 20px;

  background: rgba(255,255,255,.82);

  border: 1px solid rgba(255,255,255,.9);

  box-shadow:
    0 18px 45px rgba(35,74,65,.14);

  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);

  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 4px;

  opacity: 0;
}

#purelane-hero-{{ section.id }} .purelane-slide.active .purelane-price {
  animation:
    purelanePriceEnter
    .7s
    cubic-bezier(.16,1,.3,1)
    .5s
    forwards,

    purelanePriceFloat
    3.5s
    ease-in-out
    1.25s
    infinite;
}

@keyframes purelanePriceEnter {
  0% {
    opacity: 0;
    transform:
      translateY(35px)
      scale(.82);
  }

  100% {
    opacity: 1;
    transform:
      translateY(0)
      scale(1);
  }
}

@keyframes purelanePriceFloat {
  0%,
  100% {
    transform: translateY(0);
  }

  50% {
    transform: translateY(-8px);
  }
}

#purelane-hero-{{ section.id }} .price-label {
  display: block;

  color: var(--orange);

  font-size: 10px;
  font-weight: 800;

  letter-spacing: .14em;
  text-transform: uppercase;
}

#purelane-hero-{{ section.id }} .price-value {
  color: var(--navy);

  font-size: 23px;
  line-height: 1;

  font-weight: 900;
}

#purelane-hero-{{ section.id }} .price-old {
  margin-left: 5px;

  color: #777;

  font-size: 11px;
  font-weight: 500;
  text-decoration: line-through;
}

#purelane-hero-{{ section.id }} .price-discount {
  width: fit-content;

  margin-top: 4px;
  padding: 4px 8px;

  border-radius: 20px;

  background: rgba(192,220,150,.35);

  border: 1px solid rgba(130,160,70,.35);

  color: #69842d;

  font-size: 9px;
  font-weight: 800;
}

/* =========================================================
   PROPERTIES / SAFE CARD
   ========================================================= */

#purelane-hero-{{ section.id }} .purelane-properties {
  position: absolute;

  right: -10px;
  top: 50%;

  transform: translateY(-50%);

  z-index: 15;

  width: 120px;

  padding: 10px 0;

  border-radius: 22px;

  background: rgba(255,255,255,.78);

  border: 1px solid rgba(255,255,255,.9);

  box-shadow:
    0 20px 45px rgba(35,74,65,.14);

  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
}

#purelane-hero-{{ section.id }} .purelane-property {
  min-height: 92px;

  padding: 9px 8px;

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  text-align: center;

  position: relative;
}

#purelane-hero-{{ section.id }} .purelane-property + .purelane-property {
  border-top: 1px solid rgba(90,110,120,.14);
}

#purelane-hero-{{ section.id }} .property-icon {
  width: 38px;
  height: 38px;

  margin-bottom: 7px;

  border-radius: 50%;

  background: rgba(255,255,255,.75);

  border: 1px solid rgba(0,111,99,.12);

  display: flex;
  align-items: center;
  justify-content: center;

  color: #6c9b32;

  font-size: 18px;
}

#purelane-hero-{{ section.id }} .property-title {
  color: #4b4968;

  font-size: 8px;
  line-height: 1.35;

  font-weight: 800;

  letter-spacing: .11em;

  text-transform: uppercase;
}

/* =========================================================
   DOTS
   ========================================================= */

#purelane-hero-{{ section.id }} .purelane-dots {
  position: absolute;

  left: 50%;
  bottom: 42px;

  transform: translateX(-50%);

  display: flex;
  align-items: center;
  gap: 6px;

  z-index: 30;
}

#purelane-hero-{{ section.id }} .purelane-dot {
  width: 7px;
  height: 7px;

  padding: 0;
  border: 0;

  border-radius: 50%;

  background: #aebdc0;

  opacity: .55;

  cursor: pointer;

  transition:
    width .25s ease,
    background .25s ease,
    opacity .25s ease;
}

#purelane-hero-{{ section.id }} .purelane-dot.active {
  width: 22px;

  border-radius: 10px;

  background: var(--orange);

  opacity: 1;
}

/* =========================================================
   DESKTOP
   ========================================================= */

@media (min-width: 1200px) {

  #purelane-hero-{{ section.id }} .purelane-hero-inner {
    width: min(1180px, calc(100% - 100px));
    grid-template-columns: 45% 55%;
  }

  #purelane-hero-{{ section.id }} .purelane-image-wrap {
    width: 480px;
    height: 600px;
  }

  #purelane-hero-{{ section.id }} .purelane-image {
    max-height: 570px;
  }

  #purelane-hero-{{ section.id }} .purelane-properties {
    right: -20px;
  }

  #purelane-hero-{{ section.id }} .purelane-price {
    left: 3%;
    bottom: 105px;
  }
}

/* =========================================================
   TABLET
   ========================================================= */

@media (max-width: 900px) {

  #purelane-hero-{{ section.id }} {
    min-height: 850px;
  }

  #purelane-hero-{{ section.id }} .purelane-hero-inner {
    width: calc(100% - 40px);

    min-height: 820px;

    grid-template-columns: 1fr;
  }

  #purelane-hero-{{ section.id }} .purelane-copy {
    padding-top: 80px;
  }

  #purelane-hero-{{ section.id }} .purelane-visual {
    position: absolute;

    right: 0;
    bottom: 0;

    width: 65%;
    height: 500px;
  }

  #purelane-hero-{{ section.id }} .purelane-image-wrap {
    width: 330px;
    height: 430px;
  }

  #purelane-hero-{{ section.id }} .purelane-image {
    max-height: 420px;
  }

  #purelane-hero-{{ section.id }} .purelane-properties {
    right: 0;
  }

  #purelane-hero-{{ section.id }} .purelane-price {
    left: 0;
    bottom: 55px;
  }
}

/* =========================================================
   MOBILE
   ========================================================= */

@media (max-width: 600px) {

  #purelane-hero-{{ section.id }} {
    min-height: 780px;
  }

  #purelane-hero-{{ section.id }} .purelane-hero-inner {
    width: calc(100% - 32px);

    display: block;

    min-height: 760px;
  }

  #purelane-hero-{{ section.id }} .purelane-copy {
    padding-top: 65px;
  }

  #purelane-hero-{{ section.id }} .purelane-heading {
    font-size: 62px;
    line-height: .88;
  }

  #purelane-hero-{{ section.id }} .purelane-description {
    max-width: 330px;
    font-size: 16px;
  }

  #purelane-hero-{{ section.id }} .purelane-visual {
    position: absolute;

    left: 0;
    bottom: 0;

    width: 100%;
    height: 390px;
  }

  #purelane-hero-{{ section.id }} .purelane-image-wrap {
    width: 250px;
    height: 350px;
  }

  #purelane-hero-{{ section.id }} .purelane-image {
    max-height: 340px;
    max-width: 250px;
  }

  #purelane-hero-{{ section.id }} .purelane-properties {
    right: -4px;
    width: 92px;
  }

  #purelane-hero-{{ section.id }} .purelane-property {
    min-height: 70px;
  }

  #purelane-hero-{{ section.id }} .property-icon {
    width: 30px;
    height: 30px;
    font-size: 14px;
  }

  #purelane-hero-{{ section.id }} .property-title {
    font-size: 6px;
  }

  #purelane-hero-{{ section.id }} .purelane-price {
    left: 2%;
    bottom: 55px;

    width: 120px;
    min-height: 82px;

    padding: 12px;
  }

  #purelane-hero-{{ section.id }} .price-value {
    font-size: 19px;
  }

  #purelane-hero-{{ section.id }} .price-label {
    font-size: 8px;
  }

  #purelane-hero-{{ section.id }} .purelane-dots {
    bottom: 15px;
  }
}

/* =========================================================
   REDUCED MOTION
   ========================================================= */

@media (prefers-reduced-motion: reduce) {

  #purelane-hero-{{ section.id }} .purelane-image,
  #purelane-hero-{{ section.id }} .purelane-price {
    animation: none !important;
    opacity: 1 !important;
    transform: none !important;
  }
}
</style>


<section
  id="purelane-hero-{{ section.id }}"
  class="purelane-hero"
  data-section-id="{{ section.id }}"
>


  <div class="purelane-hero-bg"></div>
  <div class="purelane-wave"></div>


  <div class="purelane-hero-inner">

    <!-- =====================================================
         LEFT CONTENT
         ===================================================== -->

    <div class="purelane-copy">

      <h1 class="purelane-heading">

        {{ section.settings.heading_line_one }}

        <br>

        {{ section.settings.heading_line_two }}

        <br>

        <span class="highlight">
          {{ section.settings.heading_highlight }}
        </span>

      </h1>


      <div class="purelane-divider">

        <span class="purelane-divider-line"></span>

        <span class="purelane-divider-leaf">
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M12 21C12 14 15 9 22 5"/>
            <path d="M12 17C9 12 6 9 2 9"/>
          </svg>
        </span>

        <span class="purelane-divider-line"></span>

      </div>


      {% if section.settings.description != blank %}

        <div class="purelane-description">
          {{ section.settings.description }}
        </div>

      {% endif %}


      <div class="purelane-buttons">

        {% if section.settings.primary_text != blank %}

          <a
            href="{{ section.settings.primary_link | default: '#shop' }}"
            class="purelane-button purelane-button-primary"
          >

            {{ section.settings.primary_text }}

            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M5 12h13"/>
              <path d="m13 6 6 6-6 6"/>
            </svg>

          </a>

        {% endif %}


        {% if section.settings.secondary_text != blank %}

          <a
            href="{{ section.settings.secondary_link | default: '#how' }}"
            class="purelane-button purelane-button-secondary"
          >
            {{ section.settings.secondary_text }}
          </a>

        {% endif %}

      </div>

    </div>


    <!-- =====================================================
         RIGHT VISUAL
         ===================================================== -->

    <div
      class="purelane-visual"
      data-purelane-slider
    >

      {% assign slides = section.blocks | where: 'type', 'hero_slide' %}

      {% if slides.size > 0 %}

        {% for block in slides %}

          <div
            class="purelane-slide{% if forloop.first %} active{% endif %}"
            data-slide="{{ forloop.index0 }}"
            {{ block.shopify_attributes }}
          >

            <!-- IMAGE -->

            <div class="purelane-image-wrap">

              {% if block.settings.image != blank %}

                {{
                  block.settings.image
                  | image_url: width: 1000
                  | image_tag:
                    class: 'purelane-image',
                    loading: 'lazy',
                    widths: '400, 600, 800, 1000',
                    sizes: '(max-width: 600px) 250px, 480px',
                    alt: block.settings.image_alt
                }}

              {% else %}

                <div class="purelane-empty-image">
                  Upload hero image from Theme Editor
                </div>

              {% endif %}

            </div>


            <!-- =================================================
                 PRICE TAG
                 ================================================= -->

            {% if block.settings.price != blank %}

              <div class="purelane-price">

                {% if block.settings.price_label != blank %}
                  <span class="price-label">
                    {{ block.settings.price_label }}
                  </span>
                {% endif %}

                <div>

                  <span class="price-value">
                    {{ block.settings.price }}
                  </span>

                  {% if block.settings.compare_price != blank %}

                    <span class="price-old">
                      {{ block.settings.compare_price }}
                    </span>

                  {% endif %}

                </div>

                {% if block.settings.discount != blank %}

                  <span class="price-discount">
                    {{ block.settings.discount }}
                  </span>

                {% endif %}

              </div>

            {% endif %}


            <!-- =================================================
                 PROPERTIES
                 ================================================= -->

            <div class="purelane-properties">

              {% if block.settings.property_one_enabled %}

                <div class="purelane-property">

                  <div class="property-icon">
                    🌿
                  </div>

                  <div class="property-title">
                    {{ block.settings.property_one }}
                  </div>

                </div>

              {% endif %}


              {% if block.settings.property_two_enabled %}

                <div class="purelane-property">

                  <div class="property-icon">
                    ♡
                  </div>

                  <div class="property-title">
                    {{ block.settings.property_two }}
                  </div>

                </div>

              {% endif %}


              {% if block.settings.property_three_enabled %}

                <div class="purelane-property">

                  <div class="property-icon">
                    ◯
                  </div>

                  <div class="property-title">
                    {{ block.settings.property_three }}
                  </div>

                </div>

              {% endif %}

            </div>

          </div>

        {% endfor %}


        <!-- =================================================
             DOTS
             ================================================= -->

        {% if slides.size > 1 %}

          <div class="purelane-dots">

            {% for block in slides %}

              <button
                type="button"
                class="purelane-dot{% if forloop.first %} active{% endif %}"
                data-slide-dot="{{ forloop.index0 }}"
                aria-label="Show slide {{ forloop.index }}"
              ></button>

            {% endfor %}

          </div>

        {% endif %}

      {% endif %}

    </div>

  </div>

</section>


<script>
(function () {

  const root = document.getElementById(
    'purelane-hero-{{ section.id }}'
  );

  if (!root) return;

  const slider = root.querySelector('[data-purelane-slider]');

  if (!slider) return;

  const slides = Array.from(
    slider.querySelectorAll('.purelane-slide')
  );

  const dots = Array.from(
    root.querySelectorAll('.purelane-dot')
  );

  if (!slides.length) return;


  let current = 0;

  let timer = null;

  const interval =
    {{ section.settings.animation_speed | default: 4500 }};


  function showSlide(index) {

    if (!slides.length) return;

    current =
      (index + slides.length) %
      slides.length;


    slides.forEach(function (slide, i) {

      slide.classList.toggle(
        'active',
        i === current
      );

    });


    dots.forEach(function (dot, i) {

      dot.classList.toggle(
        'active',
        i === current
      );

    });

  }


  function nextSlide() {

    showSlide(current + 1);

  }


  function startAutoPlay() {

    stopAutoPlay();

    if (slides.length <= 1) return;

    timer = setInterval(
      nextSlide,
      interval
    );

  }


  function stopAutoPlay() {

    if (timer) {

      clearInterval(timer);

      timer = null;

    }

  }


  /* DOT CLICK */

  dots.forEach(function (dot) {

    dot.addEventListener(
      'click',
      function () {

        const index =
          Number(
            dot.getAttribute('data-slide-dot')
          );

        showSlide(index);

        startAutoPlay();

      }
    );

  });


  /* ========================================================
     SWIPE
     ======================================================== */

  let startX = 0;

  let startY = 0;

  let dragging = false;


  slider.addEventListener(
    'touchstart',
    function (event) {

      const touch =
        event.touches[0];

      startX = touch.clientX;

      startY = touch.clientY;

      dragging = true;

      stopAutoPlay();

    },
    { passive: true }
  );


  slider.addEventListener(
    'touchend',
    function (event) {

      if (!dragging) return;

      const touch =
        event.changedTouches[0];

      const deltaX =
        touch.clientX - startX;

      const deltaY =
        touch.clientY - startY;

      dragging = false;


      if (
        Math.abs(deltaX) > 50 &&
        Math.abs(deltaX) > Math.abs(deltaY)
      ) {

        if (deltaX < 0) {

          showSlide(current + 1);

        } else {

          showSlide(current - 1);

        }

      }


      startAutoPlay();

    },
    { passive: true }
  );


  /* ========================================================
     MOUSE DRAG
     ======================================================== */

  let mouseStartX = 0;

  let mouseDragging = false;


  slider.addEventListener(
    'mousedown',
    function (event) {

      mouseStartX =
        event.clientX;

      mouseDragging = true;

      stopAutoPlay();

      slider.style.cursor = 'grabbing';

    }
  );


  slider.addEventListener(
    'mouseup',
    function (event) {

      if (!mouseDragging) return;

      const delta =
        event.clientX - mouseStartX;

      mouseDragging = false;

      slider.style.cursor = '';

      if (Math.abs(delta) > 50) {

        if (delta < 0) {

          showSlide(current + 1);

        } else {

          showSlide(current - 1);

        }

      }

      startAutoPlay();

    }
  );


  slider.addEventListener(
    'mouseleave',
    function () {

      if (mouseDragging) {

        mouseDragging = false;

        slider.style.cursor = '';

        startAutoPlay();

      }

    }
  );


  /* ========================================================
     START
     ======================================================== */

  showSlide(0);

  startAutoPlay();


})();
</script>


