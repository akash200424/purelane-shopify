<section id="combos" class="pl-combos-section">

  <div class="pl-combos-container">

    <!-- HEADER -->
    <div class="pl-combos-heading">

      {% if section.settings.kicker != blank %}
        <p class="pl-combos-kicker">
          {{ section.settings.kicker }}
        </p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="pl-combos-title">
          {{ section.settings.heading }}
        </h2>
      {% endif %}

      <div class="pl-combos-divider">
        <span></span>
        <span>⌁</span>
        <span></span>
      </div>

      {% if section.settings.description != blank %}
        <p class="pl-combos-description">
          {{ section.settings.description }}
        </p>
      {% endif %}

    </div>


    <!-- BUNDLE CARDS -->
    <div class="pl-combos-slider">

      <div class="pl-combos-track" id="PlCombosTrack-{{ section.id }}">

        {% for block in section.blocks %}

          <article
            class="pl-combo-card"
            {{ block.shopify_attributes }}
          >

            <!-- BADGES -->
            {% if block.settings.badge != blank or block.settings.secondary_badge != blank %}
              <div class="pl-combo-badges">

                {% if block.settings.badge != blank %}
                  <span class="pl-combo-badge">
                    {{ block.settings.badge }}
                  </span>
                {% endif %}

                {% if block.settings.secondary_badge != blank %}
                  <span class="pl-combo-badge pl-combo-badge-dark">
                    {{ block.settings.secondary_badge }}
                  </span>
                {% endif %}

              </div>
            {% endif %}


            <!-- DYNAMIC BUNDLE IMAGE -->
            <div class="pl-combo-image">

              {% if block.settings.image != blank %}

                {{
                  block.settings.image
                  | image_url: width: 1200
                  | image_tag:
                    loading: 'lazy',
                    widths: '400,600,800,1000,1200',
                    sizes: '(max-width: 600px) 90vw, (max-width: 1000px) 45vw, 280px',
                    class: 'pl-combo-image-img',
                    alt: block.settings.title
                }}

              {% endif %}

            </div>


            <!-- CONTENT -->
            <div class="pl-combo-content">

              {% if block.settings.title != blank %}
                <h3 class="pl-combo-card-title">
                  {{ block.settings.title }}
                </h3>
              {% endif %}

              {% if block.settings.product_count != blank %}
                <p class="pl-combo-count">
                  {{ block.settings.product_count }}
                </p>
              {% endif %}

              {% if block.settings.description != blank %}
                <p class="pl-combo-card-description">
                  {{ block.settings.description }}
                </p>
              {% endif %}


              <!-- PRICE -->
              {% if block.settings.price != blank or block.settings.compare_price != blank or block.settings.saving != blank %}
                <div class="pl-combo-price">

                  {% if block.settings.price != blank %}
                    <strong>
                      {{ block.settings.price }}
                    </strong>
                  {% endif %}

                  {% if block.settings.compare_price != blank %}
                    <del>
                      {{ block.settings.compare_price }}
                    </del>
                  {% endif %}

                  {% if block.settings.saving != blank %}
                    <span>
                      {{ block.settings.saving }}
                    </span>
                  {% endif %}

                </div>
              {% endif %}


              <!-- TAX -->
              {% if block.settings.tax_text != blank %}
                <p class="pl-combo-tax">
                  {{ block.settings.tax_text }}
                </p>
              {% endif %}


              <!-- BUTTON -->
              {% if block.settings.button_text != blank %}

                <a
                  href="{{ block.settings.button_link | default: '#' }}"
                  class="pl-combo-button"
                >
                  {{ block.settings.button_text }}
                  <span>→</span>
                </a>

              {% endif %}

            </div>

          </article>

        {% endfor %}

      </div>

    </div>


    <!-- SWIPE TEXT -->
    {% if section.settings.swipe_text != blank %}
      <p class="pl-combos-swipe">
        <span>←</span>
        {{ section.settings.swipe_text }}
        <span>→</span>
      </p>
    {% endif %}


    {% if section.settings.bottom_text != blank %}
      <p class="pl-combos-bottom-text">
        {{ section.settings.bottom_text }}
      </p>
    {% endif %}

  </div>

</section>


<style>

/* =========================================================
   SECTION
   ========================================================= */

#combos {
  width: 100%;
}

.pl-combos-section {
  width: 100%;
  padding: 90px 0 100px;
  overflow: hidden;
}

.pl-combos-container {
  width: min(1180px, calc(100% - 40px));
  margin: 0 auto;
}


/* =========================================================
   HEADER
   ========================================================= */

.pl-combos-heading {
  text-align: center;
  margin-bottom: 48px;
}

.pl-combos-kicker {
  margin: 0 0 16px;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 3px;
  color: #737987;
  text-transform: uppercase;
}

.pl-combos-title {
  margin: 0;
  font-size: clamp(40px, 5vw, 60px);
  line-height: 1;
  font-weight: 900;
  color: #17132f;
  text-transform: uppercase;
}

.pl-combos-divider {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 16px;
  margin: 25px 0;
}

.pl-combos-divider span:first-child,
.pl-combos-divider span:last-child {
  width: 55px;
  height: 1px;
  background: rgba(30, 40, 70, 0.2);
}

.pl-combos-divider span:nth-child(2) {
  color: #d88918;
  font-size: 20px;
}

.pl-combos-description {
  max-width: 650px;
  margin: 0 auto;
  font-size: 17px;
  line-height: 1.55;
  color: #596075;
}


/* =========================================================
   SLIDER
   ========================================================= */

.pl-combos-slider {
  position: relative;
  width: 100%;
}


/*
  IMPORTANT:
  Dynamic horizontal slider.
  Shopify blocks automatically become slides.
*/

.pl-combos-track {
  display: flex;
  flex-wrap: nowrap;
  gap: 16px;

  width: 100%;

  overflow-x: auto;
  overflow-y: hidden;

  padding: 8px 2px 25px;

  scroll-behavior: smooth;
  scroll-snap-type: x mandatory;

  -webkit-overflow-scrolling: touch;

  cursor: grab;

  scrollbar-width: none;

  touch-action: pan-x;
}

.pl-combos-track::-webkit-scrollbar {
  display: none;
}

.pl-combos-track.is-dragging {
  cursor: grabbing;
  scroll-behavior: auto;
  scroll-snap-type: none;
}


/* =========================================================
   CARD
   ========================================================= */

.pl-combo-card {
  position: relative;

  flex: 0 0 calc((100% - 48px) / 4);

  min-width: 0;

  overflow: hidden;

  border-radius: 25px;

  border: 1px solid rgba(130, 150, 155, 0.28);

  background:
    linear-gradient(
      145deg,
      rgba(255,255,255,0.94),
      rgba(210,235,228,0.84)
    );

  box-shadow:
    0 15px 35px rgba(45, 65, 70, 0.08);

  scroll-snap-align: start;

  transition:
    transform 0.3s ease,
    box-shadow 0.3s ease;
}

.pl-combo-card:hover {
  transform: translateY(-5px);

  box-shadow:
    0 22px 45px rgba(45, 65, 70, 0.14);
}


/* =========================================================
   BADGES
   ========================================================= */

.pl-combo-badges {
  position: absolute;

  z-index: 5;

  top: 16px;
  left: 16px;
  right: 16px;

  display: flex;
  justify-content: space-between;
  align-items: flex-start;

  gap: 8px;

  pointer-events: none;
}

.pl-combo-badge {
  display: inline-flex;
  align-items: center;

  min-height: 28px;

  padding: 6px 12px;

  border-radius: 999px;

  border: 1px solid rgba(215, 145, 30, 0.35);

  background: rgba(255,255,255,0.92);

  color: #67952e;

  font-size: 10px;
  font-weight: 800;

  letter-spacing: 1.2px;

  text-transform: uppercase;

  white-space: nowrap;
}

.pl-combo-badge-dark {
  color: #fff;

  border-color: #087d76;

  background: #087d76;
}


/* =========================================================
   IMAGE AREA
   ========================================================= */

.pl-combo-image {
  position: relative;

  width: 100%;
  height: 230px;

  display: flex;
  align-items: center;
  justify-content: center;

  overflow: hidden;

  background:
    linear-gradient(
      145deg,
      rgba(255,255,255,0.88),
      rgba(224,239,237,0.78)
    );

  border-bottom: 1px solid rgba(100, 120, 130, 0.15);

  box-sizing: border-box;
}


/*
  Dynamic uploaded image.

  The original image keeps its ratio.
  It will NEVER stretch outside the card.
*/

.pl-combo-image-img {
  display: block;

  width: 100%;
  height: 100%;

  max-width: 100%;
  max-height: 100%;

  object-fit: contain;
  object-position: center;

  padding: 8px;

  box-sizing: border-box;

  user-select: none;
  -webkit-user-drag: none;

  transition:
    transform 0.45s cubic-bezier(.2,.8,.2,1),
    opacity 0.3s ease;
}


/* Small zoom when hovering */

.pl-combo-card:hover .pl-combo-image-img {
  transform: scale(1.035);
}


/* =========================================================
   CONTENT
   ========================================================= */

.pl-combo-content {
  padding: 18px 16px 16px;
}

.pl-combo-card-title {
  margin: 0 0 7px;

  color: #19152f;

  font-size: 18px;
  line-height: 1.2;

  font-weight: 800;

  text-transform: uppercase;
}

.pl-combo-count {
  margin: 0 0 15px;

  color: #747b87;

  font-size: 11px;
  font-weight: 700;

  letter-spacing: 1.5px;

  text-transform: uppercase;
}

.pl-combo-card-description {
  min-height: 75px;

  margin: 0 0 20px;

  color: #5d6677;

  font-size: 13px;
  line-height: 1.55;
}


/* =========================================================
   PRICE
   ========================================================= */

.pl-combo-price {
  display: flex;
  align-items: center;
  flex-wrap: wrap;

  gap: 9px;

  margin-bottom: 8px;
}

.pl-combo-price strong {
  color: #17132f;

  font-size: 25px;
  font-weight: 900;
}

.pl-combo-price del {
  color: #7b8088;

  font-size: 12px;
}

.pl-combo-price span {
  padding: 5px 9px;

  border-radius: 999px;

  border: 1px solid rgba(120, 160, 50, 0.35);

  color: #63922d;

  background: rgba(210, 230, 170, 0.3);

  font-size: 10px;
  font-weight: 700;
}


/* =========================================================
   TAX
   ========================================================= */

.pl-combo-tax {
  margin: 0 0 15px;

  color: #7b8088;

  font-size: 10px;
}


/* =========================================================
   BUTTON
   ========================================================= */

.pl-combo-button {
  width: 100%;

  min-height: 46px;

  display: flex;
  align-items: center;
  justify-content: center;

  gap: 10px;

  border-radius: 999px;

  background: rgba(255,255,255,0.92);

  border: 1px solid rgba(120, 140, 150, 0.2);

  color: #075f5b;

  text-decoration: none;

  font-size: 12px;
  font-weight: 800;

  letter-spacing: 1.5px;

  transition:
    background 0.25s ease,
    color 0.25s ease,
    transform 0.25s ease;
}

.pl-combo-button span {
  font-size: 18px;
}

.pl-combo-button:hover {
  background: #087d76;
  color: #fff;

  transform: translateY(-2px);
}


/* =========================================================
   SWIPE TEXT
   ========================================================= */

.pl-combos-swipe {
  margin: 20px 0 0;

  text-align: center;

  color: #707887;

  font-size: 11px;
  font-weight: 700;

  letter-spacing: 1.5px;

  text-transform: uppercase;

  user-select: none;
}

.pl-combos-swipe span {
  color: #d88918;
  margin: 0 7px;
}

.pl-combos-bottom-text {
  max-width: 800px;

  margin: 15px auto 0;

  text-align: center;

  color: #6d7482;

  font-size: 12px;
  line-height: 1.5;
}


/* =========================================================
   TABLET
   ========================================================= */

@media screen and (max-width: 1000px) {

  .pl-combo-card {
    flex: 0 0 calc((100% - 16px) / 2);
  }

}


/* =========================================================
   MOBILE
   ========================================================= */

@media screen and (max-width: 600px) {

  .pl-combos-section {
    padding: 60px 0 70px;
  }

  .pl-combos-container {
    width: calc(100% - 28px);
  }

  .pl-combos-heading {
    margin-bottom: 35px;
  }

  .pl-combos-title {
    font-size: clamp(34px, 10vw, 48px);
  }

  .pl-combos-description {
    font-size: 15px;
  }

  .pl-combos-track {
    gap: 14px;

    padding-left: 2px;
    padding-right: 2px;

    scroll-padding-left: 2px;
  }

  .pl-combo-card {
    flex: 0 0 88%;
  }

  .pl-combo-image {
    height: 220px;
  }

  .pl-combo-card-description {
    min-height: auto;
  }

}


/* =========================================================
   REDUCE MOTION
   ========================================================= */

@media (prefers-reduced-motion: reduce) {

  .pl-combos-track {
    scroll-behavior: auto;
  }

  .pl-combo-card,
  .pl-combo-image-img,
  .pl-combo-button {
    transition: none;
  }

}

</style>


<script>
(function () {

  function initComboSlider(section) {

    const slider = section.querySelector('.pl-combos-track');

    if (!slider) return;

    /*
      Prevent duplicate initialization
    */

    if (slider.dataset.initialized === 'true') return;

    slider.dataset.initialized = 'true';


    let isDown = false;
    let startX = 0;
    let startScrollLeft = 0;
    let moved = false;


    /*
      MOUSE DRAG
      Desktop:
      click + drag left/right
    */

    slider.addEventListener('mousedown', function (event) {

      if (event.button !== 0) return;

      isDown = true;
      moved = false;

      startX = event.pageX;
      startScrollLeft = slider.scrollLeft;

      slider.classList.add('is-dragging');

    });


    slider.addEventListener('mousemove', function (event) {

      if (!isDown) return;

      const distance = event.pageX - startX;

      if (Math.abs(distance) > 5) {
        moved = true;
      }

      slider.scrollLeft = startScrollLeft - distance;

    });


    function stopDragging() {

      if (!isDown) return;

      isDown = false;

      slider.classList.remove('is-dragging');

    }


    slider.addEventListener('mouseup', stopDragging);
    slider.addEventListener('mouseleave', stopDragging);


    /*
      TOUCH
      Mobile automatically supports:
      swipe left
      swipe right
    */

    let touchStartX = 0;
    let touchStartScroll = 0;


    slider.addEventListener(
      'touchstart',
      function (event) {

        if (!event.touches.length) return;

        touchStartX = event.touches[0].clientX;
        touchStartScroll = slider.scrollLeft;

      },
      {
        passive: true
      }
    );


    slider.addEventListener(
      'touchmove',
      function (event) {

        if (!event.touches.length) return;

        const currentX = event.touches[0].clientX;
        const distance = currentX - touchStartX;

        slider.scrollLeft = touchStartScroll - distance;

      },
      {
        passive: true
      }
    );


    /*
      Prevent accidental link click after dragging
    */

    slider.addEventListener(
      'click',
      function (event) {

        if (moved) {

          event.preventDefault();
          event.stopPropagation();

          moved = false;

        }

      },
      true
    );

  }


  /*
    Shopify theme editor support
  */

  function initAllComboSliders() {

    document
      .querySelectorAll('.pl-combos-section')
      .forEach(initComboSlider);

  }


  if (document.readyState === 'loading') {

    document.addEventListener(
      'DOMContentLoaded',
      initAllComboSliders
    );

  } else {

    initAllComboSliders();

  }


  /*
    Shopify Theme Editor
  */

  document.addEventListener(
    'shopify:section:load',
    function (event) {

      const section = event.target;

      if (
        section &&
        section.querySelector &&
        section.querySelector('.pl-combos-section')
      ) {

        initComboSlider(
          section.querySelector('.pl-combos-section')
        );

      }

    }
  );

})();
</script>


{% schema %}
{
  "name": "Best Selling Combos",

  "settings": [

    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Pre-built to save you money"
    },

    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Best Selling Combos"
    },

    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Swipe through the boxes people order most. Each one is already priced below buying the same products on their own."
    },

    {
      "type": "text",
      "id": "swipe_text",
      "label": "Swipe text",
      "default": "Swipe for more combos"
    },

    {
      "type": "textarea",
      "id": "bottom_text",
      "label": "Bottom text",
      "default": "Tapping Shop Bundle opens the bundle picker with these products already added. You can still swap anything before you pay."
    }

  ],

  "blocks": [

    {
      "type": "combo",
      "name": "Bundle",

      "settings": [

        {
          "type": "image_picker",
          "id": "image",
          "label": "Bundle image"
        },

        {
          "type": "text",
          "id": "badge",
          "label": "Badge",
          "default": "You save"
        },

        {
          "type": "text",
          "id": "secondary_badge",
          "label": "Secondary badge"
        },

        {
          "type": "text",
          "id": "title",
          "label": "Bundle title"
        },

        {
          "type": "text",
          "id": "product_count",
          "label": "Product count"
        },

        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        },

        {
          "type": "text",
          "id": "price",
          "label": "Price"
        },

        {
          "type": "text",
          "id": "compare_price",
          "label": "Compare price"
        },

        {
          "type": "text",
          "id": "saving",
          "label": "Saving"
        },

        {
          "type": "text",
          "id": "tax_text",
          "label": "Tax text",
          "default": "Inclusive of all taxes · COD available"
        },

        {
          "type": "text",
          "id": "button_text",
          "label": "Button text",
          "default": "Shop bundle"
        },

        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }

      ]

    }

  ],

  "presets": [
    {
      "name": "Best Selling Combos"
    }
  ]

}
{% endschema %}