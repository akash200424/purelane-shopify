<section
  id="combos"
  class="combo-section"
  data-combo-section
>

  <div class="combo-wrap">

    <!-- HEADER -->

    <div class="combo-header">

      {% if section.settings.kicker != blank %}
        <span class="combo-kicker">
          {{ section.settings.kicker }}
        </span>
      {% endif %}


      {% if section.settings.heading != blank %}
        <h2 class="combo-heading">
          {{ section.settings.heading }}
        </h2>
      {% endif %}


      <div class="combo-rule">

        <span></span>

        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
          <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
        </svg>

        <span></span>

      </div>


      {% if section.settings.description != blank %}
        <p class="combo-description">
          {{ section.settings.description }}
        </p>
      {% endif %}

    </div>


    <!-- SLIDER -->

    <div
      class="combo-slider"
      data-combo-slider
      tabindex="0"
      aria-label="{{ section.settings.slider_label }}"
    >

      {% assign combo_blocks = section.blocks | where: 'type', 'combo' %}

      {% for block in combo_blocks %}

        {% assign product_1 = block.settings.product_1 %}
        {% assign product_2 = block.settings.product_2 %}
        {% assign product_3 = block.settings.product_3 %}


        <article
          class="
            combo-card
            {% if block.settings.featured %}
              combo-card-featured
            {% endif %}
          "
          {{ block.shopify_attributes }}
        >

          <!-- =========================
               CARD TOP
          ========================== -->

          <div class="combo-card-top">


            {% if block.settings.save_badge != blank %}

              <span class="combo-save">
                {{ block.settings.save_badge }}
              </span>

            {% endif %}


            {% if block.settings.secondary_badge != blank %}

              <span
                class="
                  {% if block.settings.featured %}
                    combo-best-value
                  {% else %}
                    combo-popular
                  {% endif %}
                "
              >
                {{ block.settings.secondary_badge }}
              </span>

            {% endif %}


            <!-- PRODUCTS -->

            <div
              class="
                combo-products
                {% if product_3 == blank %}
                  combo-products-two
                {% endif %}
              "
            >


              {% if product_1 != blank %}

                <div class="combo-product">

                  {% if product_1.featured_image != blank %}

                    <div class="combo-product-image">

                      {{
                        product_1.featured_image
                        | image_url: width: 300
                        | image_tag:
                          loading: 'lazy',
                          alt: product_1.title
                      }}

                    </div>

                  {% else %}

                    <div class="combo-bottle combo-bottle-purple">

                      <span class="combo-pump"></span>
                      <span class="combo-label"></span>

                    </div>

                  {% endif %}


                  {% if block.settings.product_1_text != blank %}

                    <span>
                      {{ block.settings.product_1_text }}
                    </span>

                  {% else %}

                    <span>
                      {{ product_1.title }}
                    </span>

                  {% endif %}

                </div>

              {% endif %}


              {% if product_2 != blank %}

                <span class="combo-plus">
                  +
                </span>


                <div class="combo-product">

                  {% if product_2.featured_image != blank %}

                    <div class="combo-product-image">

                      {{
                        product_2.featured_image
                        | image_url: width: 300
                        | image_tag:
                          loading: 'lazy',
                          alt: product_2.title
                      }}

                    </div>

                  {% else %}

                    <div class="combo-bottle combo-bottle-purple">

                      <span class="combo-pump"></span>
                      <span class="combo-label"></span>

                    </div>

                  {% endif %}


                  {% if block.settings.product_2_text != blank %}

                    <span>
                      {{ block.settings.product_2_text }}
                    </span>

                  {% else %}

                    <span>
                      {{ product_2.title }}
                    </span>

                  {% endif %}

                </div>

              {% endif %}


              {% if product_3 != blank %}

                <span class="combo-plus">
                  +
                </span>


                <div class="combo-product">

                  {% if product_3.featured_image != blank %}

                    <div class="combo-product-image">

                      {{
                        product_3.featured_image
                        | image_url: width: 300
                        | image_tag:
                          loading: 'lazy',
                          alt: product_3.title
                      }}

                    </div>

                  {% else %}

                    <div class="combo-bottle combo-bottle-purple">

                      <span class="combo-pump"></span>
                      <span class="combo-label"></span>

                    </div>

                  {% endif %}


                  {% if block.settings.product_3_text != blank %}

                    <span>
                      {{ block.settings.product_3_text }}
                    </span>

                  {% else %}

                    <span>
                      {{ product_3.title }}
                    </span>

                  {% endif %}

                </div>

              {% endif %}

            </div>

          </div>


          <!-- =========================
               CARD BODY
          ========================== -->

          <div class="combo-card-body">


            {% if block.settings.title != blank %}

              <h3>
                {{ block.settings.title }}
              </h3>

            {% endif %}


            {% if block.settings.product_count != blank %}

              <div class="combo-count">
                {{ block.settings.product_count }}
              </div>

            {% elsif product_1 != blank %}

              <div class="combo-count">

                {% assign combo_count = 0 %}

                {% if product_1 != blank %}
                  {% assign combo_count = combo_count | plus: 1 %}
                {% endif %}

                {% if product_2 != blank %}
                  {% assign combo_count = combo_count | plus: 1 %}
                {% endif %}

                {% if product_3 != blank %}
                  {% assign combo_count = combo_count | plus: 1 %}
                {% endif %}

                {{ combo_count }} PRODUCTS

              </div>

            {% endif %}


            {% if block.settings.description != blank %}

              <p>
                {{ block.settings.description }}
              </p>

            {% endif %}


            <!-- PRICE -->

            <div class="combo-price-row">

              {% if block.settings.price != blank %}

                <strong>
                  {{ block.settings.price }}
                </strong>

              {% endif %}


              {% if block.settings.compare_price != blank %}

                <s>
                  {{ block.settings.compare_price }}
                </s>

              {% endif %}


              {% if block.settings.savings != blank %}

                <em>
                  {{ block.settings.savings }}
                </em>

              {% endif %}

            </div>


            {% if block.settings.fine_print != blank %}

              <div class="combo-fine">
                {{ block.settings.fine_print }}
              </div>

            {% endif %}


            <!-- BUTTON -->

            {% if block.settings.button_text != blank %}

              <a
                href="{{ block.settings.button_link | default: '#bundles' }}"
                class="
                  combo-button
                  {% if block.settings.featured %}
                    combo-button-dark
                  {% else %}
                    combo-button-light
                  {% endif %}
                "
              >

                {{ block.settings.button_text }}

                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M5 12h13"/>
                  <path d="m13 6 6 6-6 6"/>
                </svg>

              </a>

            {% endif %}

          </div>

        </article>

      {% endfor %}

    </div>


    <!-- SWIPE INDICATOR -->

    {% if section.settings.show_swipe_cue %}

      <div class="combo-swipe-cue">

        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 12h13"/>
          <path d="m13 6 6 6-6 6"/>
        </svg>

        {{ section.settings.swipe_text }}

      </div>

    {% endif %}


    {% if section.settings.note != blank %}

      <p class="combo-note">
        {{ section.settings.note }}
      </p>

    {% endif %}

  </div>

</section>


<script>

  document.addEventListener('DOMContentLoaded', function () {

    const sliders = document.querySelectorAll('[data-combo-slider]');

    sliders.forEach(function (slider) {

      let isDown = false;
      let startX = 0;
      let scrollLeft = 0;


      /* =========================
         MOUSE DRAG
      ========================== */

      slider.addEventListener('mousedown', function (event) {

        isDown = true;

        slider.classList.add('is-dragging');

        startX = event.pageX - slider.offsetLeft;

        scrollLeft = slider.scrollLeft;

      });


      slider.addEventListener('mouseleave', function () {

        isDown = false;

        slider.classList.remove('is-dragging');

      });


      slider.addEventListener('mouseup', function () {

        isDown = false;

        slider.classList.remove('is-dragging');

      });


      slider.addEventListener('mousemove', function (event) {

        if (!isDown) return;

        event.preventDefault();

        const x = event.pageX - slider.offsetLeft;

        const walk = (x - startX) * 1.4;

        slider.scrollLeft = scrollLeft - walk;

      });


      /* =========================
         MOUSE WHEEL
      ========================== */

      slider.addEventListener(
        'wheel',
        function (event) {

          if (
            Math.abs(event.deltaY) >
            Math.abs(event.deltaX)
          ) {

            event.preventDefault();

            slider.scrollLeft += event.deltaY;

          }

        },
        {
          passive: false
        }
      );

    });

  });

</script>


