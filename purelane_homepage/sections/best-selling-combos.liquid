<section
  class="sec"
  id="combos"
  data-scene="3"
>

  <div class="wrap">

    <div class="panel-head rv">

      <span class="kicker">
        {{ section.settings.kicker }}
      </span>

      <h2
        class="d2"
        style="margin-top:12px"
      >
        {{ section.settings.heading }}
      </h2>

      <div class="rule">
        <i></i>

        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
          <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
        </svg>

        <i></i>
      </div>

      <p
        class="lede"
        style="margin:14px auto 0"
      >
        {{ section.settings.description }}
      </p>

    </div>


    <div class="comborail rv">

      {% for block in section.blocks %}

        <article
          class="glass combo {% if block.settings.featured %}hero-combo{% endif %}"
          {{ block.shopify_attributes }}
        >

          <div class="tray">

            {% if block.settings.saving != blank %}
              <span class="save">
                {{ block.settings.saving }}
              </span>
            {% endif %}

            {% if block.settings.flag != blank %}
              <span class="flag">
                {{ block.settings.flag }}
              </span>
            {% endif %}


            <div class="stack">

              {% for i in (1..3) %}

                {% assign product_key = 'product_' | append: i %}
                {% assign product = all_products[block.settings[product_key]] %}

                {% if product != blank %}

                  {% unless forloop.first %}
                    <span
                      class="plus"
                      aria-hidden="true"
                    >
                      +
                    </span>
                  {% endunless %}


                  <span class="it">

                    {% if product.featured_image %}

                      {{
                        product.featured_image
                        | image_url: width: 250
                        | image_tag:
                          class: 'pimg',
                          loading: 'lazy',
                          alt: product.title
                      }}

                    {% else %}

                      <span
                        class="tile"
                        aria-label="{{ product.title | escape }}"
                      >
                        <svg
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.6"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        >
                          <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
                          <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
                        </svg>
                      </span>

                    {% endif %}
                    {% assign product_text_key = product_key | append: '_text' %}
                    <span>
                        {{ block.settings[product_text_key] }}
                    </span>

                  </span>

                {% endif %}

              {% endfor %}

            </div>

          </div>


          <div class="body">

            <h3>
              {{ block.settings.title }}
            </h3>

            <div class="cnt">
              {{ block.settings.product_count }}
            </div>

            <p class="inc">
              {{ block.settings.description }}
            </p>


            <div class="prow">

              <strong>
                {{ block.settings.price }}
              </strong>

              <s>
                {{ block.settings.compare_price }}
              </s>

              <em>
                {{ block.settings.saving }}
              </em>

            </div>


            <div class="fine">
              Inclusive of all taxes · COD available
            </div>


            <a
              class="btn {% if block.settings.featured %}btn-primary{% else %}btn-ghost{% endif %}"
              href="{{ block.settings.link }}"
            >
              {{ block.settings.button_text }}

              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M5 12h13m-5-6 6 6-6 6"/>
              </svg>

            </a>

          </div>

        </article>

      {% endfor %}

    </div>


    <div
      class="swipecue"
      aria-hidden="true"
    >
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M5 12h13m-5-6 6 6-6 6"/>
      </svg>

      Swipe for more combos
    </div>


    <p class="railnote">
      {{ section.settings.note }}
    </p>

  </div>

</section>


{% schema %}
{
  "name": "Best-selling Combos",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Pre-built to save you money"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Best selling combos"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Swipe through the boxes people order most. Each one is already priced below buying the same products on their own."
    },
    {
      "type": "textarea",
      "id": "note",
      "label": "Bottom note",
      "default": "Tapping Shop bundle opens the bundle picker with these products already added. You can still swap anything before you pay."
    }
  ],
  "blocks": [
    {
      "type": "combo",
      "name": "Combo",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Kitchen essentials"
        },
        {
          "type": "text",
          "id": "product_count",
          "label": "Product count",
          "default": "3 products"
        },
        {
          "type": "product",
          "id": "product_1",
          "label": "Product 1"
        },
        {
          "type": "text",
          "id": "product_1_text",
          "label": "Product 1 text",
          "default": "Cuts grease instantly"
        },
        {
          "type": "product",
          "id": "product_2",
          "label": "Product 2"
        },
        {
          "type": "text",
          "id": "product_2_text",
          "label": "Product 2 text",
          "default": "Squeaky clean dishes"
        },
        {
          "type": "product",
          "id": "product_3",
          "label": "Product 3"
        },
        {
          "type": "text",
          "id": "product_3_text",
          "label": "Product 3 text",
          "default": "Melts hard water stains"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Includes three Purelane products for a complete clean."
        },
        {
          "type": "text",
          "id": "price",
          "label": "Bundle price",
          "default": "₹499"
        },
        {
          "type": "text",
          "id": "compare_price",
          "label": "Compare price",
          "default": "₹897"
        },
        {
          "type": "text",
          "id": "saving",
          "label": "Saving",
          "default": "Save ₹398"
        },
        {
          "type": "text",
          "id": "flag",
          "label": "Flag",
          "default": "Most popular"
        },
        {
          "type": "checkbox",
          "id": "featured",
          "label": "Featured combo",
          "default": false
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button text",
          "default": "Shop bundle"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Best-selling Combos",
      "blocks": [
        {
          "type": "combo"
        },
        {
          "type": "combo"
        },
        {
          "type": "combo"
        }
      ]
    }
  ]
}
{% endschema %}