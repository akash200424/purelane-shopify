<section class="pl-bundles" id="bundles">

  <div class="pl-bundles__container">

    <!-- HEADER -->
    <div class="pl-bundles__header">

      <span class="pl-bundles__kicker">
        {{ section.settings.kicker }}
      </span>

      <h2 class="pl-bundles__title">
        {{ section.settings.heading }}
      </h2>

      <div class="pl-bundles__divider">
        <span></span>
        <span class="pl-bundles__leaf">⌄</span>
        <span></span>
      </div>

      <p class="pl-bundles__description">
        {{ section.settings.description }}
      </p>

    </div>


    <!-- SLIDER -->
    <div class="pl-bundles__slider-wrapper">

      <button
        class="pl-bundles__arrow pl-bundles__arrow--left"
        type="button"
        aria-label="Previous bundle"
      >
        ←
      </button>

      <div
        class="pl-bundles__slider"
        data-bundle-slider
      >

        {% for block in section.blocks %}

          <article
            class="pl-bundle-card{% if forloop.index == 2 %} is-featured{% endif %}"
            data-bundle-card
            {{ block.shopify_attributes }}
          >

            <!-- SAVING BADGE -->
            <div class="pl-bundle-card__top">

              <span class="pl-bundle-card__saving">
                {{ block.settings.saving }}
              </span>

              {% if block.settings.best_value != blank %}
                <span class="pl-bundle-card__value">
                  {{ block.settings.best_value }}
                </span>
              {% endif %}

            </div>


            <!-- PRODUCTS -->
            <div class="pl-bundle-card__products">

              {% for i in (1..3) %}

                {% assign image_key = 'product_' | append: i | append: '_image' %}
                {% assign name_key = 'product_' | append: i | append: '_name' %}
                {% assign benefit_key = 'product_' | append: i | append: '_benefit' %}

                {% assign product_image = block.settings[image_key] %}
                {% assign product_name = block.settings[name_key] %}
                {% assign product_benefit = block.settings[benefit_key] %}

                {% if product_name != blank %}

                  <div class="pl-bundle-product">

                    <div class="pl-bundle-product__image">

                      {% if product_image != blank %}

                        {{
                          product_image
                          | image_url: width: 180
                          | image_tag:
                            loading: 'lazy',
                            alt: product_name
                        }}

                      {% else %}

                        <div class="pl-bottle">
                          <div class="pl-bottle__cap"></div>

                          <div class="pl-bottle__body">
                            <div class="pl-bottle__label">
                              <span></span>
                              <span></span>
                            </div>
                          </div>
                        </div>

                      {% endif %}

                    </div>

                    <div class="pl-bundle-product__benefit">
                      {{ product_benefit }}
                    </div>

                  </div>

                  {% unless i == 3 %}
                    <span class="pl-bundle-product__plus">+</span>
                  {% endunless %}

                {% endif %}

              {% endfor %}

            </div>


            <!-- CARD CONTENT -->
            <div class="pl-bundle-card__content">

              <h3 class="pl-bundle-card__title">
                {{ block.settings.title }}
              </h3>

              <span class="pl-bundle-card__count">
                {{ block.settings.product_count }}
              </span>

              <p class="pl-bundle-card__description">
                {{ block.settings.description }}
              </p>


              <!-- PRICE -->
              <div class="pl-bundle-card__pricing">

                <strong>
                  {{ block.settings.price }}
                </strong>

                {% if block.settings.original_price != blank %}
                  <del>
                    {{ block.settings.original_price }}
                  </del>
                {% endif %}

                <span class="pl-bundle-card__save">
                  {{ block.settings.save }}
                </span>

              </div>


              <p class="pl-bundle-card__tax">
                Inclusive of all taxes · COD available
              </p>


              <!-- BUTTON -->
              <a
                href="{{ block.settings.link }}"
                class="pl-bundle-card__button"
              >
                SHOP BUNDLE
                <span>→</span>
              </a>

            </div>

          </article>

        {% endfor %}

      </div>

      <button
        class="pl-bundles__arrow pl-bundles__arrow--right"
        type="button"
        aria-label="Next bundle"
      >
        →
      </button>

    </div>


    <!-- SLIDER FOOTER -->
    <div class="pl-bundles__footer">

      <span class="pl-bundles__swipe">
        <span>→</span>
        SWIPE FOR MORE COMBOS
      </span>

      <p>
        {{ section.settings.note }}
      </p>

    </div>

  </div>

</section>


<script>
(function () {

  const slider = document.querySelector('[data-bundle-slider]');

  if (!slider) return;

  const cards = slider.querySelectorAll('[data-bundle-card]');

  const leftButton = document.querySelector(
    '.pl-bundles__arrow--left'
  );

  const rightButton = document.querySelector(
    '.pl-bundles__arrow--right'
  );


  /*
   * CENTER ACTIVE CARD
   */
  function updateActiveCard() {

    const sliderRect = slider.getBoundingClientRect();

    const center =
      sliderRect.left +
      sliderRect.width / 2;

    let closestCard = null;
    let closestDistance = Infinity;

    cards.forEach(function (card) {

      const rect = card.getBoundingClientRect();

      const cardCenter =
        rect.left +
        rect.width / 2;

      const distance =
        Math.abs(center - cardCenter);

      if (distance < closestDistance) {

        closestDistance = distance;
        closestCard = card;

      }

    });

    cards.forEach(function (card) {
      card.classList.remove('is-active');
    });

    if (closestCard) {
      closestCard.classList.add('is-active');
    }

  }


  /*
   * SCROLL TO CARD
   */
  function scrollToCard(direction) {

    const current =
      slider.querySelector('.is-active') ||
      cards[0];

    let index =
      Array.from(cards).indexOf(current);

    index += direction;

    if (index < 0) {
      index = cards.length - 1;
    }

    if (index >= cards.length) {
      index = 0;
    }

    cards[index].scrollIntoView({
      behavior: 'smooth',
      block: 'nearest',
      inline: 'center'
    });

  }


  /*
   * ARROWS
   */
  if (leftButton) {

    leftButton.addEventListener('click', function () {
      scrollToCard(-1);
    });

  }

  if (rightButton) {

    rightButton.addEventListener('click', function () {
      scrollToCard(1);
    });

  }


  /*
   * UPDATE ACTIVE CARD
   */
  slider.addEventListener('scroll', function () {

    window.requestAnimationFrame(
      updateActiveCard
    );

  });


  /*
   * MOUSE DRAG
   */
  let isDragging = false;
  let startX = 0;
  let startScroll = 0;

  slider.addEventListener(
    'mousedown',
    function (event) {

      isDragging = true;

      slider.classList.add('is-dragging');

      startX = event.pageX;

      startScroll = slider.scrollLeft;

    }
  );


  slider.addEventListener(
    'mousemove',
    function (event) {

      if (!isDragging) return;

      event.preventDefault();

      const distance =
        event.pageX - startX;

      slider.scrollLeft =
        startScroll - distance;

    }
  );


  function stopDragging() {

    isDragging = false;

    slider.classList.remove(
      'is-dragging'
    );

  }

  slider.addEventListener(
    'mouseup',
    stopDragging
  );

  slider.addEventListener(
    'mouseleave',
    stopDragging
  );


  /*
   * TOUCH SWIPE
   */
  let touchStartX = 0;
  let touchStartScroll = 0;

  slider.addEventListener(
    'touchstart',
    function (event) {

      touchStartX =
        event.touches[0].clientX;

      touchStartScroll =
        slider.scrollLeft;

    },
    { passive: true }
  );


  slider.addEventListener(
    'touchmove',
    function (event) {

      const currentX =
        event.touches[0].clientX;

      const distance =
        currentX - touchStartX;

      slider.scrollLeft =
        touchStartScroll - distance;

    },
    { passive: true }
  );


  /*
   * INITIAL ACTIVE CARD
   */
  setTimeout(
    updateActiveCard,
    100
  );

})();
</script>


