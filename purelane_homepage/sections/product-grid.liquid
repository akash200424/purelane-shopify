<section id="shop" class="pl-shop-section">

  <!-- =====================================================
       BESTSELLERS
       ===================================================== -->

  <div class="pl-shop-container">

    <div class="pl-shop-heading">

      <p class="pl-shop-kicker">
        {{ section.settings.kicker }}
      </p>

      <h2 class="pl-shop-title">
        {{ section.settings.heading }}
      </h2>

      <div class="pl-shop-divider">
        <span></span>
        <span>⌁</span>
        <span></span>
      </div>

    </div>


    <!-- PRODUCT GRID -->

    <div class="pl-products-grid">

      {% assign shop_collection = collections.all %}

      {% for product in shop_collection.products limit: section.settings.products_to_show %}

        <article class="pl-product-card">

          <!-- PRODUCT IMAGE -->

          <div class="pl-product-image">

            {% if forloop.index == 1 %}
              <span class="pl-product-badge">
                BEST SELLER
              </span>
            {% elsif forloop.index == 2 %}
              <span class="pl-product-badge">
                BEST SELLER
              </span>
            {% elsif forloop.index == 3 %}
              <span class="pl-product-badge">
                TOP RATED
              </span>
            {% else %}
              <span class="pl-product-badge">
                NEW
              </span>
            {% endif %}


            {% if product.featured_image %}

              <img
                src="{{ product.featured_image | image_url: width: 600 }}"
                alt="{{ product.featured_image.alt | default: product.title | escape }}"
                loading="lazy"
                width="600"
                height="600"
              >

            {% else %}

              <div class="pl-fallback-bottle">
                <span></span>
              </div>

            {% endif %}

          </div>


          <!-- PRODUCT INFORMATION -->

          <div class="pl-product-info">

            <h3 class="pl-product-title">
              {{ product.title }}
            </h3>


            <div class="pl-product-rating">

              <span class="pl-stars">
                ★
              </span>

              <strong>
                4.8
              </strong>

              <span>
                · {{ 180 | plus: forloop.index | times: 3 }} reviews
              </span>

            </div>


            <div class="pl-product-price">

              <strong>
                {{ product.price | money }}
              </strong>

              {% if product.compare_at_price > product.price %}

                <del>
                  {{ product.compare_at_price | money }}
                </del>

                <span class="pl-product-discount">
                  33% off
                </span>

              {% else %}

                <del>
                  ₹299
                </del>

                <span class="pl-product-discount">
                  33% off
                </span>

              {% endif %}

            </div>


            <!-- ADD TO CART -->

            {% form 'product', product, class: 'pl-product-form' %}

              <input
                type="hidden"
                name="id"
                value="{{ product.selected_or_first_available_variant.id }}"
              >

              <button
                type="submit"
                class="pl-add-cart"
                {% unless product.available %}
                  disabled
                {% endunless %}
              >

                {% if product.available %}
                  ADD TO CART
                {% else %}
                  SOLD OUT
                {% endif %}

              </button>

            {% endform %}

          </div>

        </article>

      {% else %}

        <!-- FALLBACK PRODUCTS -->

        {% for i in (1..8) %}

          <article class="pl-product-card">

            <div class="pl-product-image">

              <span class="pl-product-badge">
                BEST SELLER
              </span>

              <div class="pl-fallback-bottle">
                <span></span>
              </div>

            </div>

            <div class="pl-product-info">

              <h3 class="pl-product-title">
                Purelane Home Cleaner
              </h3>

              <div class="pl-product-rating">
                <span class="pl-stars">★</span>
                <strong>4.8</strong>
                <span>· 200 reviews</span>
              </div>

              <div class="pl-product-price">
                <strong>₹200</strong>
                <del>₹299</del>
                <span class="pl-product-discount">
                  33% off
                </span>
              </div>

              <a href="#shop" class="pl-add-cart">
                ADD TO CART
              </a>

            </div>

          </article>

        {% endfor %}

      {% endfor %}

    </div>

  </div>



  <!-- =====================================================
       EVERY ROOM / SHELF
       ===================================================== -->

  <div class="pl-shelf-container">

    <div class="pl-shelf-header">

      <div>

        <p class="pl-shelf-kicker">
          THE FULL RANGE
        </p>

        <h2>
          EVERY ROOM, ONE SHELF
        </h2>

      </div>

      <p class="pl-shelf-description">
        Floors, taps, kitchen, laundry, bathroom and hands.
        Fourteen plant-based formulas that replace every harsh
        bottle under your sink.
      </p>

    </div>


    <!-- HORIZONTAL SWIPE AREA -->

    <div class="pl-shelf-wrapper">

      <div class="pl-shelf-track">

        {% for i in (1..9) %}

          <div class="pl-shelf-bottle">

            <div class="pl-shelf-bottle-cap"></div>

            <div class="pl-shelf-bottle-body">

              <div class="pl-shelf-label">
                <span></span>
                <span></span>
              </div>

            </div>

          </div>

        {% endfor %}


        <!-- ORANGE BOX -->

        <div class="pl-shelf-box">

          <span></span>
          <span></span>

        </div>

      </div>

    </div>


    <p class="pl-shelf-swipe">
      Swipe to see the full shelf
    </p>

  </div>



  <!-- =====================================================
       WHY BUNDLES
       ===================================================== -->

  <div class="pl-why-bundles-container">

    <div class="pl-why-bundles-heading">

      <p>
        THE SMARTER WAY TO SHOP
      </p>

      <h2>
        WHY BUNDLES BEAT BUYING SINGLE
      </h2>

    </div>


    <div class="pl-why-bundles-grid">


      <!-- BENEFIT 1 -->

      <div class="pl-why-card">

        <div class="pl-why-icon">
          $
        </div>

        <h3>
          SAVE UP TO 45%
        </h3>

        <p>
          Versus buying the same products separately
        </p>

      </div>


      <!-- BENEFIT 2 -->

      <div class="pl-why-card">

        <div class="pl-why-icon">
          ✓
        </div>

        <h3>
          ONE FLAT PRICE
        </h3>

        <p>
          No calculators, no comparing carts
        </p>

      </div>


      <!-- BENEFIT 3 -->

      <div class="pl-why-card">

        <div class="pl-why-icon">
          ★
        </div>

        <h3>
          CURATED BY EXPERTS
        </h3>

        <p>
          Products picked to work well together
        </p>

      </div>


      <!-- BENEFIT 4 -->

      <div class="pl-why-card">

        <div class="pl-why-icon">
          🚚
        </div>

        <h3>
          FREE SHIPPING ALWAYS
        </h3>

        <p>
          Included on every bundle, all India
        </p>

      </div>

    </div>

  </div>

</section>


{% schema %}

{
  "name": "Product Grid",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Bestsellers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by 30,000 homes"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Product Grid"
    }
  ]
}

{% endschema %}