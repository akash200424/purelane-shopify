<section class="sec" id="shop" data-scene="3">

  <div class="wrap">

    <div class="panel-head rv">

      <span class="kicker">
        {{ section.settings.kicker }}
      </span>

      <h2
        class="d2"
        style="margin-top:12px"
      >
        {{ section.settings.heading }}
      </h2>

      <div class="rule">

        <i></i>

        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
          <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
        </svg>

        <i></i>

      </div>

    </div>


    <div class="shelf">

      {% assign collection = collections[section.settings.collection] %}

      {% if collection != blank %}

        {% for product in collection.products limit: section.settings.products_to_show %}

          <article
            class="glass card rv {% if forloop.index == 2 %}rv-d1{% elsif forloop.index == 3 %}rv-d2{% elsif forloop.index == 4 %}rv-d3{% endif %}"
          >

            <div class="shot">

              {% if product.tags contains 'Best seller' %}
                <span class="pill">
                  Best seller
                </span>
              {% elsif product.tags contains 'New' %}
                <span class="pill">
                  New
                </span>
              {% endif %}


              {% if product.featured_image %}

                <a
                  href="{{ product.url }}"
                  aria-label="{{ product.title | escape }}"
                >
                  {{
                    product.featured_image
                    | image_url: width: 500
                    | image_tag:
                      loading: 'lazy',
                      widths: '240,360,500',
                      sizes: '(min-width: 860px) 25vw, 50vw',
                      alt: product.featured_image.alt | default: product.title
                  }}
                </a>

              {% else %}

                <span
                  class="pimg"
                  role="img"
                  aria-label="{{ product.title | escape }}"
                ></span>

              {% endif %}

            </div>


            <h4>
              <a href="{{ product.url }}">
                {{ product.title }}
              </a>
            </h4>


            <div class="rate">

              {% if product.metafields.custom.rating != blank %}

                <b>
                  ★ {{ product.metafields.custom.rating }}
                </b>

                {% if product.metafields.custom.review_count != blank %}
                  · {{ product.metafields.custom.review_count }} reviews
                {% endif %}

              {% else %}

                <b>
                  ★ 4.8
                </b>

              {% endif %}

            </div>


            <div class="pr">

              <strong>
                {{ product.price | money }}
              </strong>

              {% if product.compare_at_price > product.price %}

                <s>
                  {{ product.compare_at_price | money }}
                </s>

                <em>
                  {{ product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round }}% off
                </em>

              {% endif %}

            </div>


            {% if product.available %}

              <form
                method="post"
                action="{{ routes.cart_add_url }}"
              >

                <input
                  type="hidden"
                  name="id"
                  value="{{ product.selected_or_first_available_variant.id }}"
                >

                <button
                  type="submit"
                  class="btn btn-ghost btn-sm"
                >
                  Add to cart
                </button>

              </form>

            {% else %}

              <button
                type="button"
                class="btn btn-ghost btn-sm"
                disabled
              >
                Sold out
              </button>

            {% endif %}

          </article>

        {% endfor %}

      {% else %}

        <p>
          Select a product collection in the theme editor.
        </p>

      {% endif %}

    </div>

  </div>

</section>


{% schema %}
{
  "name": "Purelane Product Grid",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Bestsellers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by 30,000 homes"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Product collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Purelane Product Grid"
    }
  ]
}
{% endschema %}