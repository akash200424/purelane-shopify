<section class="reviews-section" id="reviews-{{ section.id }}">

  <!-- TOP RATING BAR -->
  <div class="reviews-header">

    <span class="reviews-label">
      THAT'S WHAT THEY SAID
    </span>

    <div class="reviews-rating">
      <span class="reviews-stars">★★★★★</span>
      <strong>4.8</strong>
      <span>FROM 8,000+ REVIEWS</span>
    </div>

    <span class="reviews-loved">
      LOVED BY <strong>12 LAKH+</strong> HOMES
    </span>

  </div>


  <!-- MOVING REVIEW TRACK -->
  <div class="reviews-window">

    <div class="reviews-track">

      <!-- FIRST SET -->
      {% for block in section.blocks %}

        <article
          class="review-card"
          {{ block.shopify_attributes }}
        >

          <div class="review-stars">
            ★★★★★
          </div>

          <h3>
            {{ block.settings.title }}
          </h3>

          <p>
            {{ block.settings.text }}
          </p>

          <div class="review-author">
            <span>✓</span>
            <strong>{{ block.settings.name }}</strong>

            {% if block.settings.product != blank %}
              <span>·</span>
              <span>{{ block.settings.product }}</span>
            {% endif %}
          </div>

        </article>

      {% endfor %}


      <!-- DUPLICATED SET FOR SEAMLESS LOOP -->
      {% for block in section.blocks %}

        <article
          class="review-card"
          aria-hidden="true"
        >

          <div class="review-stars">
            ★★★★★
          </div>

          <h3>
            {{ block.settings.title }}
          </h3>

          <p>
            {{ block.settings.text }}
          </p>

          <div class="review-author">
            <span>✓</span>
            <strong>{{ block.settings.name }}</strong>

            {% if block.settings.product != blank %}
              <span>·</span>
              <span>{{ block.settings.product }}</span>
            {% endif %}
          </div>

        </article>

      {% endfor %}

    </div>

  </div>

</section>


<style>

/* =========================================================
   PURELANE REVIEWS
========================================================= */

.reviews-section {
  position: relative;

  width: 100%;

  padding: 40px 0 70px;

  overflow: hidden;

  background:
    linear-gradient(
      180deg,
      #dff4e8 0%,
      #c9ead9 48%,
      #b8dfce 100%
    );
}


/* =========================================================
   TOP RATING
========================================================= */

.reviews-header {

  width: 100%;

  min-height: 28px;

  padding: 0 25px;

  display: flex;

  align-items: center;

  justify-content: center;

  gap: 15px;

  box-sizing: border-box;

  color: #666b7c;

  font-size: 11px;

  line-height: 1;

  font-weight: 800;

  letter-spacing: 0.17em;

  text-transform: uppercase;

  white-space: nowrap;

}

.reviews-rating {

  display: flex;

  align-items: center;

  gap: 8px;

}

.reviews-stars {

  color: #6c9228;

  font-size: 13px;

  letter-spacing: 2px;

}

.reviews-rating strong {

  color: #c47a0b;

  font-size: 14px;

}

.reviews-loved strong {

  color: #bd7109;

}


/* =========================================================
   VIEWPORT
========================================================= */

.reviews-window {

  position: relative;

  width: 100%;

  margin-top: 20px;

  overflow: hidden;

}


/* =========================================================
   MOVING TRACK
========================================================= */

.reviews-track {

  display: flex;

  width: max-content;

  gap: 14px;

  padding: 0;

  margin: 0;

  animation:
    reviewsInfiniteScroll 34s linear infinite;

  will-change: transform;

}


/* =========================================================
   INFINITE ANIMATION
========================================================= */

@keyframes reviewsInfiniteScroll {

  from {
    transform: translate3d(0, 0, 0);
  }

  to {
    transform: translate3d(-50%, 0, 0);
  }

}


/* Pause when mouse is over reviews */

.reviews-window:hover .reviews-track {

  animation-play-state: paused;

}


/* =========================================================
   REVIEW CARD
========================================================= */

.review-card {

  position: relative;

  flex: 0 0 280px;

  width: 280px;

  min-height: 165px;

  box-sizing: border-box;

  padding: 21px 18px 17px;

  border-radius: 16px;

  background:
    rgba(255, 255, 255, 0.72);

  border: 1px solid rgba(255, 255, 255, 0.8);

  box-shadow:
    0 8px 25px rgba(42, 91, 70, 0.07);

  backdrop-filter: blur(13px);

  -webkit-backdrop-filter: blur(13px);

  overflow: hidden;

  transition:
    transform 0.3s ease,
    box-shadow 0.3s ease;

}


/* subtle card hover */

.review-card:hover {

  transform: translateY(-5px);

  box-shadow:
    0 16px 35px rgba(42, 91, 70, 0.13);

}


/* =========================================================
   STARS
========================================================= */

.review-card .review-stars {

  margin-bottom: 11px;

  color: #6c9228;

  font-size: 11px;

  line-height: 1;

  letter-spacing: 2px;

}


/* =========================================================
   TITLE
========================================================= */

.review-card h3 {

  margin: 0 0 8px;

  color: #191631;

  font-size: 13px;

  line-height: 1.3;

  font-weight: 900;

  letter-spacing: 0;

  text-transform: uppercase;

}


/* =========================================================
   REVIEW TEXT
========================================================= */

.review-card p {

  margin: 0 0 14px;

  color: #5a6075;

  font-size: 12.5px;

  line-height: 1.48;

  font-weight: 400;

}


/* =========================================================
   AUTHOR
========================================================= */

.review-author {

  display: flex;

  align-items: center;

  gap: 6px;

  color: #3f611e;

  font-size: 9px;

  line-height: 1.2;

  font-weight: 800;

  letter-spacing: 0.12em;

  text-transform: uppercase;

}

.review-author span:first-child {

  color: #639122;

  font-size: 13px;

  font-weight: 900;

}


/* =========================================================
   SIDE FADE
   Creates the same partially visible cards
========================================================= */

.reviews-window::before,
.reviews-window::after {

  content: "";

  position: absolute;

  top: 0;

  bottom: 0;

  width: 70px;

  z-index: 5;

  pointer-events: none;

}

.reviews-window::before {

  left: 0;

  background:
    linear-gradient(
      90deg,
      rgba(205, 235, 218, 0.85),
      transparent
    );

}

.reviews-window::after {

  right: 0;

  background:
    linear-gradient(
      270deg,
      rgba(205, 235, 218, 0.85),
      transparent
    );

}


/* =========================================================
   DESKTOP
========================================================= */

@media (min-width: 1200px) {

  .reviews-section {

    padding-top: 38px;

  }

  .review-card {

    flex-basis: 280px;

    width: 280px;

  }

}


/* =========================================================
   TABLET
========================================================= */

@media (max-width: 900px) {

  .reviews-header {

    flex-wrap: wrap;

    white-space: normal;

    gap: 8px 12px;

    text-align: center;

  }

  .reviews-track {

    animation-duration: 28s;

  }

  .review-card {

    flex-basis: 280px;

    width: 280px;

  }

}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 600px) {

  .reviews-section {

    padding: 30px 0 55px;

  }

  .reviews-header {

    width: calc(100% - 30px);

    margin: 0 auto;

    flex-direction: column;

    gap: 8px;

    font-size: 9px;

    line-height: 1.3;

  }

  .reviews-rating {

    gap: 6px;

  }

  .reviews-track {

    gap: 12px;

    animation-duration: 24s;

  }

  .review-card {

    flex-basis: 270px;

    width: 270px;

    min-height: 165px;

  }

  .reviews-window::before,
  .reviews-window::after {

    width: 35px;

  }

}


/* =========================================================
   ACCESSIBILITY
========================================================= */

@media (prefers-reduced-motion: reduce) {

  .reviews-track {

    animation: none;

  }

}

</style>


{% schema %}

{
  "name": "Reviews",

  "settings": [],

  "blocks": [

    {
      "type": "review",

      "name": "Review",

      "settings": [

        {
          "type": "text",
          "id": "title",
          "label": "Review title",
          "default": "Great product, great packaging"
        },

        {
          "type": "textarea",
