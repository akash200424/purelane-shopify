<section
  class="sec revband"
  id="reviews"
  data-scene="1"
>

  <div class="wrap">

    <div class="revhead rv">

      <span class="kicker">
        {{ section.settings.kicker }}
      </span>

      <span class="agg">

        <span class="st">
          ★★★★★
        </span>

        <b>
          {{ section.settings.rating }}
        </b>

        {{ section.settings.rating_text }}

      </span>

      <span class="agg">
        Loved by
        <b>
          {{ section.settings.homes }}
        </b>
        homes
      </span>

    </div>

  </div>


  <div
    class="revrail rv"
    aria-label="Customer reviews"
  >

    <div class="revtrack">

      {% for block in section.blocks %}

        <article
          class="glass-2 rcard"
          {{ block.shopify_attributes }}
        >

          <div class="st">
            ★★★★★
          </div>

          <h5>
            {{ block.settings.title }}
          </h5>

          <p>
            {{ block.settings.review }}
          </p>

          <div class="who">

            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="3"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="m5 13 4 4L19 7"/>
            </svg>

            <b>
              {{ block.settings.name }}
            </b>

            {% if block.settings.product != blank %}
              <span>
                · {{ block.settings.product }}
              </span>
            {% endif %}

          </div>

        </article>

      {% endfor %}


      {% for block in section.blocks %}

        <article
          class="glass-2 rcard"
          aria-hidden="true"
        >

          <div class="st">
            ★★★★★
          </div>

          <h5>
            {{ block.settings.title }}
          </h5>

          <p>
            {{ block.settings.review }}
          </p>

          <div class="who">

            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="3"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="m5 13 4 4L19 7"/>
            </svg>

            <b>
              {{ block.settings.name }}
            </b>

            {% if block.settings.product != blank %}
              <span>
                · {{ block.settings.product }}
              </span>
            {% endif %}

          </div>

        </article>

      {% endfor %}

    </div>

  </div>

</section>


{% schema %}
{
  "name": "Purelane Reviews Rail",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "That's what they said"
    },
    {
      "type": "text",
      "id": "rating",
      "label": "Rating",
      "default": "4.8"
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Rating text",
      "default": "from 8,000+ reviews"
    },
    {
      "type": "text",
      "id": "homes",
      "label": "Homes",
      "default": "12 lakh+"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Review title",
          "default": "Works like a charm"
        },
        {
          "type": "textarea",
          "id": "review",
          "label": "Review",
          "default": "Finally an eco option that cleans as well as the chemical detergent I used for years, and it smells better."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Customer name",
          "default": "Anita"
        },
        {
          "type": "text",
          "id": "product",
          "label": "Product",
          "default": "Laundry detergent"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Reviews Rail",
      "blocks": [
        {
          "type": "review"
        },
        {
          "type": "review",
          "settings": {
            "title": "Best dishwash ever",
            "review": "Our old dishwash left my help with dry, cracked skin. That stopped completely after we switched.",
            "name": "Priya",
            "product": "Dishwash gel"
          }
        },
        {
          "type": "review",
          "settings": {
            "title": "Great product, great packaging",
            "review": "Very soft on hands with a lovely fragrance, and it feels good to be using far less plastic.",
            "name": "Sunita",
            "product": "Liquid handwash"
          }
        },
        {
          "type": "review",
          "settings": {
            "title": "Dog friendly",
            "review": "We switched because chemical floor cleaners were setting off my dog's allergies. No reactions since.",
            "name": "Rohit S.",
            "product": "Floor cleaner"
          }
        },
        {
          "type": "review",
          "settings": {
            "title": "Sparkling taps again",
            "review": "Hard water had ruined our bathroom fittings. Two sprays and the scale wipes straight off, no scrubbing.",
            "name": "Verified buyer",
            "product": "Tap cleaner"
          }
        }
      ]
    }
  ]
}
{% endschema %}