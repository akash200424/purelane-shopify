<section
  id="bundle-categories-{{ section.id }}"
  class="pl-bundle-categories"
>
  <div class="pl-bundle-category-container">

    <!-- =========================
         HEADER
    ========================== -->

    <div class="pl-section-heading">

      {% if section.settings.kicker != blank %}
        <p class="pl-kicker">
          {{ section.settings.kicker }}
        </p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2>
          {{ section.settings.heading }}
        </h2>
      {% endif %}

      <div class="pl-heading-divider" aria-hidden="true">
        <span></span>

        <svg
          viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15.5 16.5 20 12 21Z"></path>
          <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"></path>
        </svg>

        <span></span>
      </div>

    </div>

    <!-- =========================
         BUNDLE CATEGORIES
    ========================== -->

    {% assign category_blocks = section.blocks | where: 'type', 'category' %}

    {% if category_blocks != blank %}
      <div class="pl-bundle-category-grid">

        {% for block in category_blocks %}

          <a
            href="{% if block.settings.link != blank %}{{ block.settings.link }}{% else %}#combos{% endif %}"
            class="pl-bundle-category-card"
            {{ block.shopify_attributes }}
          >

            <!-- CATEGORY IMAGE -->

            <div class="pl-bundle-category-image">

              {% if block.settings.image != blank %}

                {{
                  block.settings.image
                  | image_url: width: 700
                  | image_tag:
                    loading: 'lazy',
                    alt: block.settings.title
                }}

              {% elsif block.settings.product != blank and block.settings.product.featured_image != blank %}

                {{
                  block.settings.product.featured_image
                  | image_url: width: 700
                  | image_tag:
                    loading: 'lazy',
                    alt: block.settings.product.title
                }}

              {% else %}

                <div class="pl-bottle {{ block.settings.bottle_style | default: 'pl-bottle-large' }}">

                  <div class="pl-bottle-cap"></div>

                  <div class="pl-bottle-body">
                    <div class="pl-bottle-label">
                      <span></span>
                      <span></span>
                    </div>
                  </div>

                </div>

              {% endif %}

            </div>

            <!-- CATEGORY CONTENT -->

            <div class="pl-bundle-category-content">

              {% if block.settings.title != blank %}
                <h3>
                  {{ block.settings.title }}
                </h3>
              {% endif %}

              {% if block.settings.description != blank %}
                <p>
                  {{ block.settings.description }}
                </p>
              {% endif %}

            </div>

          </a>

        {% endfor %}

      </div>
    {% endif %}

    <!-- =========================
         BENEFITS STRIP
    ========================== -->

    {% assign benefit_blocks = section.blocks | where: 'type', 'benefit' %}

    {% if benefit_blocks != blank %}

      <div class="pl-bundle-benefits">

        {% for block in benefit_blocks %}

          <div
            class="pl-bundle-benefit"
            {{ block.shopify_attributes }}
          >

            <div class="pl-benefit-icon">

              {% if block.settings.icon != blank %}

                {{ block.settings.icon }}

              {% else %}

                <svg
                  viewBox="0 0 24 24"
                  xmlns="http://www.w3.org/2000/svg"
                  aria-hidden="true"
                >
                  <circle
                    cx="12"
                    cy="12"
                    r="8"
                    fill="none"
                  ></circle>
                </svg>

              {% endif %}

            </div>

            <div class="pl-benefit-text">

              {% if block.settings.line_one != blank %}
                <span>
                  {{ block.settings.line_one }}
                </span>
              {% endif %}

              {% if block.settings.line_two != blank %}
                <span>
                  {{ block.settings.line_two }}
                </span>
              {% endif %}

            </div>

          </div>

        {% endfor %}

      </div>

    {% endif %}

    <!-- =========================
         PURELANE CLUB
    ========================== -->

    {% if section.settings.show_club %}

      <div class="pl-club-card">

        {% if section.settings.club_kicker != blank %}
          <p class="pl-kicker">
            {{ section.settings.club_kicker }}
          </p>
        {% endif %}

        {% if section.settings.club_heading != blank %}
          <h2>
            {{ section.settings.club_heading }}
          </h2>
        {% endif %}

        {% if section.settings.club_description != blank %}
          <p class="pl-club-description">
            {{ section.settings.club_description }}
          </p>
        {% endif %}

        {% form 'customer', class: 'pl-club-form' %}

          <input
            type="hidden"
            name="contact[tags]"
            value="{{ section.settings.customer_tag }}"
          >

          <input
            type="email"
            name="contact[email]"
            value="{{ form.email }}"
            placeholder="{{ section.settings.email_placeholder }}"
            aria-label="{{ section.settings.email_label }}"
            autocomplete="email"
            required
          >

          <button type="submit">
            {{ section.settings.club_button }}
          </button>

          {% if form.posted_successfully? %}
            <p class="pl-form-message">
              Thanks for joining the Purelane Club!
            </p>
          {% endif %}

          {% if form.errors %}
            <div class="pl-form-errors">
              {{ form.errors | default_errors }}
            </div>
          {% endif %}

        {% endform %}

      </div>

    {% endif %}

  </div>
</section>

{% style %}

  #bundle-categories-{{ section.id }} {
    width: 100%;
  }

  #bundle-categories-{{ section.id }} .pl-bundle-category-container {
    width: min(1200px, calc(100% - 40px));
    margin: 0 auto;
  }

  #bundle-categories-{{ section.id }} .pl-section-heading {
    text-align: center;
    margin-bottom: 40px;
  }

  #bundle-categories-{{ section.id }} .pl-kicker {
    margin: 0 0 10px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.18em;
  }

  #bundle-categories-{{ section.id }} .pl-section-heading h2,
  #bundle-categories-{{ section.id }} .pl-club-card h2 {
    margin: 0;
  }

  #bundle-categories-{{ section.id }} .pl-heading-divider {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    margin-top: 18px;
  }

  #bundle-categories-{{ section.id }} .pl-heading-divider span {
    display: block;
    width: 60px;
    height: 1px;
    background: currentColor;
    opacity: 0.35;
  }

  #bundle-categories-{{ section.id }} .pl-heading-divider svg {
    width: 24px;
    height: 24px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  #bundle-categories-{{ section.id }} .pl-bundle-category-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
  }

  #bundle-categories-{{ section.id }} .pl-bundle-category-card {
    display: block;
    text-decoration: none;
    color: inherit;
    overflow: hidden;
    border-radius: 20px;
  }

  #bundle-categories-{{ section.id }} .pl-bundle-category-image {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 280px;
    overflow: hidden;
    border-radius: 20px;
  }

  #bundle-categories-{{ section.id }} .pl-bundle-category-image img {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 280px;
    object-fit: cover;
  }

  #bundle-categories-{{ section.id }} .pl-bundle-category-content {
    padding: 18px 4px 0;
    text-align: center;
  }

  #bundle-categories-{{ section.id }} .pl-bundle-category-content h3 {
    margin: 0;
    font-size: 17px;
    line-height: 1.2;
  }

  #bundle-categories-{{ section.id }} .pl-bundle-category-content p {
    margin: 7px 0 0;
    opacity: 0.7;
    font-size: 14px;
  }

  #bundle-categories-{{ section.id }} .pl-bundle-benefits {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
    margin-top: 50px;
    padding: 28px 0;
    border-top: 1px solid rgba(0, 0, 0, 0.12);
    border-bottom: 1px solid rgba(0, 0, 0, 0.12);
  }

  #bundle-categories-{{ section.id }} .pl-bundle-benefit {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    text-align: left;
  }

  #bundle-categories-{{ section.id }} .pl-benefit-icon {
    width: 34px;
    min-width: 34px;
    height: 34px;
  }

  #bundle-categories-{{ section.id }} .pl-benefit-icon svg {
    width: 100%;
    height: 100%;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  #bundle-categories-{{ section.id }} .pl-benefit-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  #bundle-categories-{{ section.id }} .pl-benefit-text span {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  #bundle-categories-{{ section.id }} .pl-club-card {
    margin-top: 50px;
    padding: 45px 30px;
    text-align: center;
    border-radius: 24px;
  }

  #bundle-categories-{{ section.id }} .pl-club-description {
    max-width: 600px;
    margin: 12px auto 24px;
    opacity: 0.75;
  }

  #bundle-categories-{{ section.id }} .pl-club-form {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    max-width: 650px;
    margin: 0 auto;
  }

  #bundle-categories-{{ section.id }} .pl-club-form input[type="email"] {
    flex: 1 1 280px;
    min-height: 50px;
    padding: 0 16px;
    border: 1px solid rgba(0, 0, 0, 0.2);
    border-radius: 999px;
    background: transparent;
  }

  #bundle-categories-{{ section.id }} .pl-club-form button {
    min-height: 50px;
    padding: 0 24px;
    border: 0;
    border-radius: 999px;
    cursor: pointer;
  }

  #bundle-categories-{{ section.id }} .pl-form-message,
  #bundle-categories-{{ section.id }} .pl-form-errors {
    width: 100%;
    margin: 10px 0 0;
  }

  /* Fallback bottle */

  #bundle-categories-{{ section.id }} .pl-bottle {
    position: relative;
    width: 130px;
    height: 240px;
  }

  #bundle-categories-{{ section.id }} .pl-bottle-cap {
    position: absolute;
    top: 0;
    left: 50%;
    width: 48px;
    height: 28px;
    transform: translateX(-50%);
    border-radius: 8px 8px 3px 3px;
    background: currentColor;
  }

  #bundle-categories-{{ section.id }} .pl-bottle-body {
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 110px;
    height: 210px;
    transform: translateX(-50%);
    border-radius: 18px 18px 25px 25px;
    background: currentColor;
  }

  #bundle-categories-{{ section.id }} .pl-bottle-label {
    position: absolute;
    top: 70px;
    left: 50%;
    width: 78px;
    height: 65px;
    transform: translateX(-50%);
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.75);
  }

  #bundle-categories-{{ section.id }} .pl-bottle-label span {
    display: block;
    width: 50%;
    height: 2px;
    margin: 12px auto 0;
    background: rgba(0, 0, 0, 0.25);
  }

  #bundle-categories-{{ section.id }} .pl-bottle-medium {
    width: 120px;
    height: 220px;
  }

  #bundle-categories-{{ section.id }} .pl-bottle-medium .pl-bottle-body {
    width: 100px;
    height: 190px;
  }

  #bundle-categories-{{ section.id }} .pl-bottle-dark {
    width: 120px;
    height: 225px;
  }

  #bundle-categories-{{ section.id }} .pl-bottle-dark .pl-bottle-body {
    width: 102px;
    height: 195px;
  }

  @media screen and (max-width: 900px) {
    #bundle-categories-{{ section.id }} .pl-bundle-category-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    #bundle-categories-{{ section.id }} .pl-bundle-benefits {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 600px) {
    #bundle-categories-{{ section.id }} .pl-bundle-category-container {
      width: min(100% - 24px, 1200px);
    }

    #bundle-categories-{{ section.id }} .pl-bundle-category-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    #bundle-categories-{{ section.id }} .pl-bundle-benefits {
      grid-template-columns: 1fr;
      gap: 18px;
    }

    #bundle-categories-{{ section.id }} .pl-bundle-category-image {
      min-height: 240px;
    }

    #bundle-categories-{{ section.id }} .pl-bundle-category-image img {
      min-height: 240px;
    }

    #bundle-categories-{{ section.id }} .pl-club-card {
      padding: 35px 20px;
    }
  }

{% endstyle %}

{% schema %}
{
  "name": "Bundle Categories",
  "settings": [
    {
      "type": "header",
      "content": "Section heading"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "BUNDLE CATEGORIES"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "FIND THE RIGHT BUNDLE FOR YOU"
    },
    {
      "type": "header",
      "content": "Purelane Club"
    },
    {
      "type": "checkbox",
      "id": "show_club",
      "label": "Show Purelane Club",
      "default": true
    },
    {
      "type": "text",
      "id": "club_kicker",
      "label": "Club kicker",
      "default": "JOIN THE PURELANE CLUB"
    },
    {
      "type": "text",
      "id": "club_heading",
      "label": "Club heading",
      "default": "GET ₹100 OFF YOUR FIRST BUNDLE"
    },
    {
      "type": "textarea",
      "id": "club_description",
      "label": "Club description",
      "default": "Plus first access to new launches and restocks."
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Email placeholder",
      "default": "your@email.com"
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Email accessibility label",
      "default": "Email address"
    },
    {
      "type": "text",
      "id": "club_button",
      "label": "Club button text",
      "default": "GET MY ₹100 OFF"
    },
    {
      "type": "text",
      "id": "customer_tag",
