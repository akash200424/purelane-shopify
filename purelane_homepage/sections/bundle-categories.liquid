            {
              "value": "pl-bottle-large",
              "label": "Large"
            },
            {
              "value": "pl-bottle-medium",
              "label": "Medium"
            },
            {
              "value": "pl-bottle-dark",
              "label": "Dark"
            }
          ],
          "default": "pl-bottle-large"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Category link"
        }
      ]
    },
    {
      "type": "benefit",
      "name": "Bundle benefit",
      "settings": [
        {
          "type": "textarea",
          "id": "icon",
          "label": "Icon SVG",
          "info": "Paste the SVG markup for this benefit icon."
        },
        {
          "type": "text",
          "id": "line_one",
