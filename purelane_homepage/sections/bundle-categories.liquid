<section
  id="bundle-categories"
  class="pl-bundle-categories"
>

  <div class="pl-bundle-category-container">

    <!-- =========================
         HEADER
    ========================== -->

    <div class="pl-section-heading">

      {% if section.settings.kicker != blank %}
        <p class="pl-kicker">
          {{ section.settings.kicker }}
        </p>
      {% endif %}


      {% if section.settings.heading != blank %}
        <h2>
          {{ section.settings.heading }}
        </h2>
      {% endif %}


      <div class="pl-heading-divider">

        <span></span>

        <svg
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            d="M12 21c0-6.5 3.5-11 8-12.5C20 15.5 16.5 20 12 21Z"
          />

          <path
            d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"
          />
        </svg>

        <span></span>

      </div>

    </div>


    <!-- =========================
         BUNDLE CATEGORIES
    ========================== -->

    {% assign category_blocks =
      section.blocks | where: 'type', 'category'
    %}


    {% if category_blocks.size > 0 %}

      <div class="pl-bundle-category-grid">

        {% for block in category_blocks %}

          <a
            href="{{ block.settings.link | default: '#combos' }}"
            class="pl-bundle-category-card"
            {{ block.shopify_attributes }}
          >

            <!-- CATEGORY IMAGE -->

            <div class="pl-bundle-category-image">

              {% if block.settings.image != blank %}

                {{
                  block.settings.image
                  | image_url: width: 700
                  | image_tag:
                    loading: 'lazy',
                    alt: block.settings.title
                }}

              {% elsif block.settings.product != blank
                and block.settings.product.featured_image != blank
              %}

                {{
                  block.settings.product.featured_image
                  | image_url: width: 700
                  | image_tag:
                    loading: 'lazy',
                    alt: block.settings.product.title
                }}

              {% else %}

                <div
                  class="
                    pl-bottle
                    {{ block.settings.bottle_style }}
                  "
                >

                  <div class="pl-bottle-cap"></div>

                  <div class="pl-bottle-body">

                    <div class="pl-bottle-label">

                      <span></span>
                      <span></span>

                    </div>

                  </div>

                </div>

              {% endif %}

            </div>


            <!-- CATEGORY CONTENT -->

            <div class="pl-bundle-category-content">

              {% if block.settings.title != blank %}

                <h3>
                  {{ block.settings.title }}
                </h3>

              {% endif %}


              {% if block.settings.description != blank %}

                <p>
                  {{ block.settings.description }}
                </p>

              {% endif %}

            </div>

          </a>

        {% endfor %}

      </div>

    {% endif %}


    <!-- =========================
         BENEFITS STRIP
    ========================== -->

    {% assign benefit_blocks =
      section.blocks | where: 'type', 'benefit'
    %}


    {% if benefit_blocks.size > 0 %}

      <div class="pl-bundle-benefits">

        {% for block in benefit_blocks %}

          <div
            class="pl-bundle-benefit"
            {{ block.shopify_attributes }}
          >

            <div class="pl-benefit-icon">

              {% if block.settings.icon != blank %}

                {{ block.settings.icon }}

              {% else %}

                <svg
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <circle
                    cx="12"
                    cy="12"
                    r="8"
                  />
                </svg>

              {% endif %}

            </div>


            <div>

              {% if block.settings.line_one != blank %}

                <span>
                  {{ block.settings.line_one }}
                </span>

              {% endif %}


              {% if block.settings.line_two != blank %}

                <span>
                  {{ block.settings.line_two }}
                </span>

              {% endif %}

            </div>

          </div>

        {% endfor %}

      </div>

    {% endif %}


    <!-- =========================
         PURELANE CLUB
    ========================== -->

    {% if section.settings.show_club %}

      <div class="pl-club-card">

        {% if section.settings.club_kicker != blank %}

          <p class="pl-kicker">
            {{ section.settings.club_kicker }}
          </p>

        {% endif %}


        {% if section.settings.club_heading != blank %}

          <h2>
            {{ section.settings.club_heading }}
          </h2>

        {% endif %}


        {% if section.settings.club_description != blank %}

          <p class="pl-club-description">
            {{ section.settings.club_description }}
          </p>

        {% endif %}


        {% form 'customer', class: 'pl-club-form' %}

          <input
            type="hidden"
            name="contact[tags]"
            value="{{ section.settings.customer_tag }}"
          >


          <input
            type="email"
            name="contact[email]"
            placeholder="{{ section.settings.email_placeholder }}"
            aria-label="{{ section.settings.email_label }}"
            required
          >


          <button type="submit">

            {{ section.settings.club_button }}

          </button>

        {% endform %}

      </div>

    {% endif %}

  </div>

</section>


{% schema %}

{
  "name": "Bundle Categories",

  "settings": [

    {
      "type": "header",
      "content": "Section heading"
    },

    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "BUNDLE CATEGORIES"
    },

    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "FIND THE RIGHT BUNDLE FOR YOU"
    },


    {
      "type": "header",
      "content": "Purelane Club"
    },

    {
      "type": "checkbox",
      "id": "show_club",
      "label": "Show Purelane Club",
      "default": true
    },

    {
      "type": "text",
      "id": "club_kicker",
      "label": "Club kicker",
      "default": "JOIN THE PURELANE CLUB"
    },

    {
      "type": "text",
      "id": "club_heading",
      "label": "Club heading",
      "default": "GET ₹100 OFF YOUR FIRST BUNDLE"
    },

    {
      "type": "textarea",
      "id": "club_description",
      "label": "Club description",
      "default": "Plus first access to new launches and restocks."
    },

    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Email placeholder",
      "default": "your@email.com"
    },

    {
      "type": "text",
      "id": "email_label",
      "label": "Email accessibility label",
      "default": "Email address"
    },

    {
      "type": "text",
      "id": "club_button",
      "label": "Club button text",
      "default": "GET MY ₹100 OFF"
    },

    {
      "type": "text",
      "id": "customer_tag",
      "label": "Customer tag",
      "default": "purelane-club"
    }

  ],


  "blocks": [

    {
      "type": "category",

      "name": "Bundle category",

      "settings": [

        {
          "type": "text",
          "id": "title",
          "label": "Category title",
          "default": "KITCHEN BUNDLE"
        },

        {
          "type": "text",
          "id": "description",
          "label": "Category description",
          "default": "Grease, dishes & more"
        },

        {
          "type": "image_picker",
          "id": "image",
          "label": "Category image"
        },

        {
          "type": "product",
          "id": "product",
          "label": "Fallback product"
        },

        {
          "type": "select",
          "id": "bottle_style",
          "label": "Fallback bottle style",
          "options": [
            {
              "value": "pl-bottle-large",
              "label": "Large"
            },
            {
              "value": "pl-bottle-medium",
              "label": "Medium"
            },
            {
              "value": "pl-bottle-dark",
              "label": "Dark"
            }
          ],
          "default": "pl-bottle-large"
        },

        {
          "type": "url",
          "id": "link",
          "label": "Category link"
        }

      ]

    },


    {
      "type": "benefit",

      "name": "Bundle benefit",

      "settings": [

        {
          "type": "textarea",
          "id": "icon",
          "label": "Icon SVG",
          "info": "Paste the SVG markup for this benefit icon."
        },

        {
          "type": "text",
          "id": "line_one",
          "label": "First line",
          "default": "PLANT DERIVED"
        },

        {
          "type": "text",
          "id": "line_two",
          "label": "Second line",
          "default": "FORMULAS"
        }

      ]

    }

  ],


  "presets": [

    {
      "name": "Bundle Categories",

      "blocks": [

        {
          "type": "category",

          "settings": {
            "title": "KITCHEN BUNDLE",
            "description": "Grease, dishes & more",
            "bottle_style": "pl-bottle-large",
            "link": "#combos"
          }

        },

        {
          "type": "category",

          "settings": {
            "title": "BATHROOM BUNDLE",
            "description": "Deep clean & disinfect",
            "bottle_style": "pl-bottle-medium",
            "link": "#combos"
          }

        },

        {
          "type": "category",

          "settings": {
            "title": "LAUNDRY BUNDLE",
            "description": "Softer, fresher wash",
            "bottle_style": "pl-bottle-dark",
            "link": "#combos"
          }

        },

        {
          "type": "category",

          "settings": {
            "title": "HARD WATER BUNDLE",
            "description": "Melt away limescale",
            "bottle_style": "pl-bottle-medium",
            "link": "#combos"
          }

        },


        {
          "type": "benefit",

          "settings": {
            "line_one": "PLANT DERIVED",
            "line_two": "FORMULAS",

            "icon": "<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 21c0-6.5 3.5-11 8-12.5C20 15.5 16.5 20 12 21Z\"/><path d=\"M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z\"/></svg>"
          }

        },

        {
          "type": "benefit",

          "settings": {
            "line_one": "RECYCLABLE",
            "line_two": "PACKAGING",

            "icon": "<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M5 7h14v13H5z\"/><path d=\"M8 7V4h8v3\"/><path d=\"M8 12h8\"/></svg>"
          }

        },

        {
          "type": "benefit",

          "settings": {
            "line_one": "SAFE FOR",
            "line_two": "KIDS & PETS",

            "icon": "<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 21s-7-4.5-7-10a4 4 0 0 1 7-2.5A4 4 0 0 1 19 11c0 5.5-7 10-7 10Z\"/></svg>"
          }

        },

        {
          "type": "benefit",

          "settings": {
            "line_one": "MADE IN",
            "line_two": "INDIA",

            "icon": "<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"8\"/><path d=\"M4 12h16\"/><path d=\"M12 4c2.5 2.2 3.5 5 3.5 8s-1 5.8-3.5 8\"/><path d=\"M12 4c-2.5 2.2-3.5 5-3.5 8s1 5.8 3.5 8\"/></svg>"
          }

        }

      ]

    }

  ]

}

{% endschema %}