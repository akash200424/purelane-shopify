<style>
  .pl-footer {
    width: 100%;
    background: #dff4e9;
    color: #55566f;
  }

  .pl-footer-container {
    width: min(1140px, calc(100% - 48px));
    margin: 0 auto;
  }

  .pl-footer-main {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1fr;
    gap: 70px;
    padding: 58px 0 70px;
  }

  /* BRAND */

  .pl-footer-brand {
    max-width: 330px;
  }

  .pl-footer-logo {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
  }

  .pl-footer-logo-image {
    width: 44px;
    height: 44px;
    object-fit: contain;
    border-radius: 50%;
  }

  .pl-footer-logo-mark {
    width: 44px;
    height: 44px;
    border: 1px solid rgba(40, 80, 70, 0.18);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.35);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #7cae31;
    flex-shrink: 0;
  }

  .pl-footer-logo-mark svg {
    width: 24px;
    height: 24px;
  }

  .pl-footer-wordmark {
    display: flex;
    flex-direction: column;
  }

  .pl-footer-wordmark strong {
    color: #24203f;
    font-size: 18px;
    line-height: 1;
    font-weight: 800;
    letter-spacing: -0.3px;
  }

  .pl-footer-wordmark span {
    margin-top: 5px;
    color: #9292a5;
    font-size: 8px;
    line-height: 1;
    letter-spacing: 2.2px;
    font-weight: 600;
  }

  .pl-footer-description {
    margin: 0;
    max-width: 310px;
    color: #60627b;
    font-size: 15px;
    line-height: 1.7;
  }

  /* COLUMNS */

  .pl-footer-column h3 {
    margin: 5px 0 22px;
    color: #64952d;
    font-size: 11px;
    line-height: 1;
    font-weight: 800;
    letter-spacing: 2.8px;
  }

  .pl-footer-column ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pl-footer-column li {
    margin: 0 0 15px;
  }

  .pl-footer-column a {
    color: #64667c;
    text-decoration: none;
    font-size: 15px;
    line-height: 1.4;
    transition: color 0.2s ease;
  }

  .pl-footer-column a:hover {
    color: #007c72;
  }

  .pl-footer-contact-link {
    display: block;
    margin-bottom: 15px;
  }

  .pl-footer-company {
    margin: 4px 0 0;
    color: #7d7f91;
    font-size: 13px;
    line-height: 1.5;
  }

  /* BOTTOM */

  .pl-footer-bottom {
    min-height: 70px;
    border-top: 1px solid rgba(70, 100, 90, 0.12);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
  }

  .pl-footer-copyright {
    margin: 0;
    color: #7c8190;
    font-size: 12px;
  }

  .pl-footer-legal {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .pl-footer-legal a,
  .pl-footer-legal span {
    color: #7c8190;
    font-size: 12px;
    text-decoration: none;
  }

  .pl-footer-legal a:hover {
    color: #007c72;
  }

  /* TABLET */

  @media screen and (max-width: 900px) {
    .pl-footer-main {
      grid-template-columns: 1.5fr 1fr 1fr;
      gap: 45px;
    }

    .pl-footer-contact {
      grid-column: 2 / 4;
    }
  }

  /* MOBILE */

  @media screen and (max-width: 640px) {
    .pl-footer-container {
      width: min(100% - 32px, 500px);
    }

    .pl-footer-main {
      grid-template-columns: 1fr 1fr;
      gap: 40px 25px;
      padding: 45px 0 50px;
    }

    .pl-footer-brand {
      grid-column: 1 / -1;
      max-width: 100%;
    }

    .pl-footer-contact {
      grid-column: auto;
    }

    .pl-footer-description {
      max-width: 100%;
    }

    .pl-footer-column h3 {
      margin-bottom: 18px;
    }

    .pl-footer-bottom {
      min-height: auto;
      padding: 22px 0;
      flex-direction: column;
      align-items: flex-start;
      gap: 14px;
    }

    .pl-footer-legal {
      flex-wrap: wrap;
    }
  }
</style>


<footer class="pl-footer">

  <div class="pl-footer-container">

    <div class="pl-footer-main">

      <!-- BRAND -->
      <div class="pl-footer-brand">

        <div class="pl-footer-logo">

          {% if section.settings.logo != blank %}

            <img
              class="pl-footer-logo-image"
              src="{{ section.settings.logo | image_url: width: 160 }}"
              alt="{{ section.settings.brand_name | escape }}"
              width="44"
              height="44"
              loading="lazy"
            >

          {% else %}

            <div class="pl-footer-logo-mark">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path
                  d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                />
                <path
                  d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                />
              </svg>
            </div>

          {% endif %}

          <div class="pl-footer-wordmark">

            {% if section.settings.brand_name != blank %}
              <strong>
                {{ section.settings.brand_name }}
              </strong>
            {% endif %}

            {% if section.settings.brand_tagline != blank %}
              <span>
                {{ section.settings.brand_tagline }}
              </span>
            {% endif %}

          </div>

        </div>


        {% if section.settings.brand_description != blank %}

          <p class="pl-footer-description">
            {{ section.settings.brand_description }}
          </p>

        {% endif %}

      </div>


      <!-- SHOP -->
      <div class="pl-footer-column">

        {% if section.settings.shop_heading != blank %}
          <h3>
            {{ section.settings.shop_heading }}
          </h3>
        {% endif %}

        {% if section.settings.shop_menu != blank %}

          <ul>

            {% for link in section.settings.shop_menu.links %}

              <li>
                <a href="{{ link.url }}">
                  {{ link.title }}
                </a>
              </li>

            {% endfor %}

          </ul>

        {% endif %}

      </div>


      <!-- ABOUT -->
      <div class="pl-footer-column">

        {% if section.settings.about_heading != blank %}
          <h3>
            {{ section.settings.about_heading }}
          </h3>
        {% endif %}

        {% if section.settings.about_menu != blank %}

          <ul>

            {% for link in section.settings.about_menu.links %}

              <li>
                <a href="{{ link.url }}">
                  {{ link.title }}
                </a>
              </li>

            {% endfor %}

          </ul>

        {% endif %}

      </div>


      <!-- CONTACT -->
      <div class="pl-footer-column pl-footer-contact">

        {% if section.settings.contact_heading != blank %}
          <h3>
            {{ section.settings.contact_heading }}
          </h3>
        {% endif %}


        {% if section.settings.email != blank %}

          <a
            href="mailto:{{ section.settings.email | escape }}"
            class="pl-footer-contact-link"
          >
            {{ section.settings.email }}
          </a>

        {% endif %}


        {% if section.settings.phone != blank %}

          <a
            href="tel:{{ section.settings.phone | remove: ' ' | escape }}"
            class="pl-footer-contact-link"
          >
            {{ section.settings.phone }}
          </a>

        {% endif %}


        {% if section.settings.company_name != blank %}

          <p class="pl-footer-company">
            {{ section.settings.company_name }}
          </p>

        {% endif %}

      </div>

    </div>


    <!-- BOTTOM -->

    <div class="pl-footer-bottom">

      <p class="pl-footer-copyright">

        {% if section.settings.copyright_text != blank %}

          {{ section.settings.copyright_text }}

        {% else %}

          © {{ 'now' | date: '%Y' }} {{ shop.name }}

        {% endif %}

      </p>


      <div class="pl-footer-legal">

        {% if section.settings.legal_menu != blank %}

          {% for link in section.settings.legal_menu.links %}

            <a href="{{ link.url }}">
              {{ link.title }}
            </a>

            {% unless forloop.last %}
              <span>·</span>
            {% endunless %}

          {% endfor %}

        {% endif %}

      </div>

    </div>

  </div>

</footer>


{% schema %}
{
  "name": "Purelane Footer",
  "settings": [
    {
      "type": "header",
      "content": "Brand"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand name"
    },
    {
      "type": "text",
      "id": "brand_tagline",
      "label": "Brand tagline"
    },
    {
      "type": "textarea",
      "id": "brand_description",
      "label": "Brand description"
    },

    {
      "type": "header",
      "content": "Shop navigation"
    },
    {
      "type": "text",
      "id": "shop_heading",
      "label": "Shop heading"
    },
    {
      "type": "link_list",
      "id": "shop_menu",
      "label": "Shop menu"
    },

    {
      "type": "header",
      "content": "About navigation"
    },
    {
      "type": "text",
      "id": "about_heading",
      "label": "About heading"
    },
    {
      "type": "link_list",
      "id": "about_menu",
      "label": "About menu"
    },

    {
      "type": "header",
      "content": "Contact"
    },
    {
      "type": "text",
      "id": "contact_heading",
      "label": "Contact heading"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone"
    },
    {
      "type": "text",
      "id": "company_name",
      "label": "Company name"
    },

    {
      "type": "header",
      "content": "Footer bottom"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright text"
    },
    {
      "type": "link_list",
      "id": "legal_menu",
      "label": "Legal menu"
    }
  ],
  "presets": [
    {
      "name": "Purelane Footer"
    }
  ]
}
{% endschema %}