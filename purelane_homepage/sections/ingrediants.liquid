<section class="ingredients-section">

  <!-- =========================
       SOURCED FROM NATURE
  ========================== -->

  <div class="nature-panel">

    <div class="nature-heading">

      {% if section.settings.nature_heading != blank %}
        <h2>{{ section.settings.nature_heading }}</h2>
      {% endif %}

      <div class="nature-rule">

        <span></span>

        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M12 20C12 13 14.5 7.5 20 4
               C19 10 16 14 12 16
               C8 14 5 10 4 4
               C9.5 7.5 12 13 12 20Z"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
          />
        </svg>

        <span></span>

      </div>

    </div>


    {% if section.blocks.size > 0 %}

      <div class="nature-grid">

        {% assign ingredient_blocks = section.blocks | where: 'type', 'ingredient' %}

        {% for block in ingredient_blocks %}

          <div
            class="nature-item"
            {{ block.shopify_attributes }}
          >

            <div class="nature-icon">

              {% case block.settings.icon %}

                {% when 'coconut' %}

                  <svg viewBox="0 0 80 80" aria-hidden="true">

                    <circle
                      cx="40"
                      cy="43"
                      r="20"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    />

                    <path
                      d="M22 31
                         C27 22 34 20 40 26
                         C46 20 53 22 58 31"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    />

                    <path
                      d="M30 45
                         C34 49 46 49 50 45"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    />

                    <path
                      d="M40 26V18"
                      stroke="currentColor"
                      stroke-width="2"
                    />

                  </svg>


                {% when 'orange' %}

                  <svg viewBox="0 0 80 80" aria-hidden="true">

                    <circle
                      cx="40"
                      cy="43"
                      r="18"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    />

                    <path
                      d="M40 25
                         C47 18 55 22 57 29
                         C51 29 47 28 44 25"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    />

                    <path
                      d="M40 25V61
                         M22 43H58
                         M28 31L52 55
                         M52 31L28 55"
                      stroke="currentColor"
                      stroke-width="1.4"
                      opacity=".7"
                    />

                  </svg>


                {% when 'soap_nut' %}

                  <svg viewBox="0 0 80 80" aria-hidden="true">

                    <circle
                      cx="30"
                      cy="45"
                      r="12"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    />

                    <circle
                      cx="50"
                      cy="45"
                      r="12"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    />

                    <circle
                      cx="40"
                      cy="30"
                      r="12"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    />

                    <path
                      d="M40 18
                         C42 12 47 10 50 9"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    />

                  </svg>


                {% when 'neem' %}

                  <svg viewBox="0 0 80 80" aria-hidden="true">

                    <path
                      d="M20 58
                         C35 43 43 30 59 19"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    />

                    <path
                      d="M29 48
                         C24 42 22 37 24 32
                         C29 35 32 39 32 43"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    />

                    <path
                      d="M37 40
                         C32 34 31 29 33 24
                         C38 27 40 31 40 35"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    />

                    <path
                      d="M46 31
                         C42 25 42 20 45 16
                         C49 19 51 23 50 27"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    />

                    <path
                      d="M53 25
                         C56 20 60 18 64 18
                         C62 23 59 26 54 28"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    />

                  </svg>


                {% when 'lemongrass' %}

                  <svg viewBox="0 0 80 80" aria-hidden="true">

                    <path
                      d="M40 65
                         C37 48 32 32 25 17"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    />

                    <path
                      d="M40 65
                         C42 45 47 28 58 12"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    />

                    <path
                      d="M40 65
                         C40 43 40 25 40 9"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    />

                    <path
                      d="M40 65
                         C34 46 27 34 18 25"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    />

                    <path
                      d="M40 65
                         C47 46 55 32 66 23"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    />

                  </svg>

              {% endcase %}

            </div>


            {% if block.settings.title != blank %}
              <h3>
                {{ block.settings.title }}
              </h3>
            {% endif %}


            {% if block.settings.description != blank %}
              <p>
                {{ block.settings.description }}
              </p>
            {% endif %}

          </div>

        {% endfor %}

      </div>

    {% endif %}

  </div>


  <!-- =========================
       BENEFIT CARDS
  ========================== -->

  {% assign benefit_blocks = section.blocks | where: 'type', 'benefit' %}

  {% if benefit_blocks.size > 0 %}

    <div class="benefit-grid">

      {% for block in benefit_blocks %}

        <article
          class="benefit-card"
          {{ block.shopify_attributes }}
        >

          <div class="benefit-icon">

            {% case block.settings.icon %}

              {% when 'scrubbing' %}

                <svg viewBox="0 0 24 24" aria-hidden="true">

                  <circle cx="8" cy="8" r="2.5"/>
                  <circle cx="16" cy="8" r="2.5"/>
                  <circle cx="8" cy="16" r="2.5"/>
                  <circle cx="16" cy="16" r="2.5"/>

                </svg>


              {% when 'shield' %}

                <svg viewBox="0 0 24 24" aria-hidden="true">

                  <path
                    d="M12 3
                       L20 6
                       V11
                       C20 16 16.5 19.5 12 21
                       C7.5 19.5 4 16 4 11
                       V6
                       Z"
                  />

                  <path
                    d="M8 12
                       L11 15
                       L16 9"
                  />

                </svg>


              {% when 'heart' %}

                <svg viewBox="0 0 24 24" aria-hidden="true">

                  <path
                    d="M12 20
                       C10 18
                       4 14
                       4 9
                       C4 6
                       6 4
                       9 4
                       C11 4
                       12 6
                       12 6
                       C12 6
                       13 4
                       15 4
                       C18 4
                       20 6
                       20 9
                       C20 14
                       14 18
                       12 20Z"
                  />

                </svg>

            {% endcase %}

          </div>


          {% if block.settings.title != blank %}

            <h3>
              {{ block.settings.title }}
            </h3>

          {% endif %}


          {% if block.settings.description != blank %}

            <p>
              {{ block.settings.description }}
            </p>

          {% endif %}


          {% if block.settings.button_text != blank and block.settings.button_link != blank %}

            <a
              href="{{ block.settings.button_link }}"
              class="benefit-btn"
            >
              {{ block.settings.button_text }}
            </a>

          {% endif %}

        </article>

      {% endfor %}

    </div>

  {% endif %}

</section>


{% schema %}

{
  "name": "Purelane Benefits",

  "settings": [

    {
      "type": "text",
      "id": "nature_heading",
      "label": "Nature section heading",
      "default": "SOURCED FROM NATURE"
    }

  ],

  "blocks": [

    {
      "type": "ingredient",

      "name": "Ingredient",

      "settings": [

        {
          "type": "select",
          "id": "icon",
          "label": "Ingredient icon",
          "options": [
            {
              "value": "coconut",
              "label": "Coconut"
            },
            {
              "value": "orange",
              "label": "Orange peel"
            },
            {
              "value": "soap_nut",
              "label": "Soap nut"
            },
            {
              "value": "neem",
              "label": "Neem"
            },
            {
              "value": "lemongrass",
              "label": "Lemongrass"
            }
          ],
          "default": "coconut"
        },

        {
          "type": "text",
          "id": "title",
          "label": "Ingredient title",
          "default": "COCONUT"
        },

        {
          "type": "textarea",
          "id": "description",
          "label": "Ingredient description",
          "default": "Plant-derived cleansers that lift grease"
        }

      ]

    },


    {
      "type": "benefit",

      "name": "Benefit card",

      "settings": [

        {
          "type": "select",
          "id": "icon",
          "label": "Benefit icon",
          "options": [
            {
              "value": "scrubbing",
              "label": "Less scrubbing"
            },
            {
              "value": "shield",
              "label": "Clean ingredients"
            },
            {
              "value": "heart",
              "label": "Safe around everyone"
            }
          ],
          "default": "scrubbing"
        },

        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "LESS SCRUBBING"
        },

        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "A foaming formulation. The foam clings to grease and lifts it, so you wipe instead of scrub."
        },

        {
          "type": "text",
          "id": "button_text",
          "label": "Button text",
          "default": "LEARN MORE"
        },

        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }

      ]

    }

  ],


  "presets": [

    {
      "name": "Purelane Benefits",

      "blocks": [

        {
          "type": "ingredient",

          "settings": {
            "icon": "coconut",
            "title": "COCONUT",
            "description": "Plant-derived cleansers that lift grease"
          }
        },

        {
          "type": "ingredient",

          "settings": {
            "icon": "orange",
            "title": "ORANGE PEEL",
            "description": "Natural degreaser and fresh citrus lift"
          }
        },

        {
          "type": "ingredient",

          "settings": {
            "icon": "soap_nut",
            "title": "SOAP NUT",
            "description": "A traditional plant foaming agent"
          }
        },

        {
          "type": "ingredient",

          "settings": {
            "icon": "neem",
            "title": "NEEM",
            "description": "Time-tested antibacterial from the tree"
          }
        },

        {
          "type": "ingredient",

          "settings": {
            "icon": "lemongrass",
            "title": "LEMONGRASS",
            "description": "Clean fragrance with nothing synthetic"
          }
        },


        {
          "type": "benefit",

          "settings": {
            "icon": "scrubbing",
            "title": "LESS SCRUBBING",
            "description": "A foaming formulation. The foam clings to grease and lifts it, so you wipe instead of scrub.",
            "button_text": "LEARN MORE",
            "button_link": "/pages/how-it-works"
          }
        },

        {
          "type": "benefit",

          "settings": {
            "icon": "shield",
            "title": "CLEAN INGREDIENTS",
            "description": "No sulphates, no chlorine, no synthetic fragrance. Nothing on the label you would not want near your food.",
            "button_text": "LEARN MORE",
            "button_link": "/pages/ingredients"
          }
        },

        {
          "type": "benefit",

          "settings": {
            "icon": "heart",
            "title": "SAFE AROUND EVERYONE",
            "description": "Gentle on hands, safe around kids and pets, and it leaves no toxic residue on the surfaces you touch every day.",
            "button_text": "LEARN MORE",
            "button_link": "/pages/how-it-works"
          }
        }

      ]

    }

  ]

}

{% endschema %}