{%- comment -%}
  PURELANE GLOBAL HEADER

  - Fixed/floating header
  - Curved pill only
  - No full-width background
  - Ticker removed from header
  - Navigation is merchant editable
  - Logo is merchant editable
{%- endcomment -%}


<div class="pl-header-wrapper">

  <header
    class="pl-header"
    id="PurelaneHeader"
  >

    <div class="pl-header-inner">


      <!-- =====================================================
           BRAND
           ===================================================== -->

      <a
        href="{{ routes.root_url }}"
        class="pl-brand"
        aria-label="{{ section.settings.brand_name | escape }}"
      >

        {%- if section.settings.logo != blank -%}

          {{
            section.settings.logo
            | image_url: width: 240
            | image_tag:
              class: 'pl-brand-logo',
              loading: 'eager',
              alt: section.settings.brand_name
          }}

        {%- else -%}

          <span class="pl-brand-mark">

            <svg
              viewBox="0 0 24 24"
              fill="none"
              aria-hidden="true"
            >

              <path
                d="M12 3L20.5 8V16L12 21L3.5 16V8L12 3Z"
                stroke="currentColor"
                stroke-width="1.5"
              />

              <path
                d="M12 12L20.5 8"
                stroke="currentColor"
                stroke-width="1.5"
              />

              <path
                d="M12 12V21"
                stroke="currentColor"
                stroke-width="1.5"
              />

              <path
                d="M12 12L3.5 8"
                stroke="currentColor"
                stroke-width="1.5"
              />

            </svg>

          </span>


          <span class="pl-brand-text">

            <span class="pl-brand-name">
              {{ section.settings.brand_name }}
            </span>

            {%- if section.settings.brand_tagline != blank -%}

              <span class="pl-brand-tagline">
                {{ section.settings.brand_tagline }}
              </span>

            {%- endif -%}

          </span>

        {%- endif -%}

      </a>



      <!-- =====================================================
           DESKTOP NAVIGATION
           ===================================================== -->

      <nav
        class="pl-main-nav"
        aria-label="Main navigation"
      >

        {%- for block in section.blocks -%}

          {%- if block.type == 'nav_link' -%}

            <a
              href="{{ block.settings.link | default: routes.root_url }}"
              class="pl-nav-link"
              {{ block.shopify_attributes }}
            >
              {{ block.settings.label }}
            </a>

          {%- endif -%}

        {%- endfor -%}

      </nav>



      <!-- =====================================================
           HEADER ACTIONS
           ===================================================== -->

      <div class="pl-header-actions">


        <!-- SEARCH -->

        <a
          href="{{ routes.search_url }}"
          class="pl-header-icon"
          aria-label="Search"
        >

          <svg
            viewBox="0 0 24 24"
            fill="none"
            aria-hidden="true"
          >

            <circle
              cx="11"
              cy="11"
              r="7"
              stroke="currentColor"
              stroke-width="1.7"
            />

            <path
              d="M20 20L16.2 16.2"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
            />

          </svg>

        </a>



        <!-- ACCOUNT -->

        {%- if shop.customer_accounts_enabled -%}

          <a
            href="{{ routes.account_url }}"
            class="pl-header-icon pl-account-icon"
            aria-label="Account"
          >

            <svg
              viewBox="0 0 24 24"
              fill="none"
              aria-hidden="true"
            >

              <circle
                cx="12"
                cy="8"
                r="3.5"
                stroke="currentColor"
                stroke-width="1.7"
              />

              <path
                d="M5 20C5 16.4 8 14.3 12 14.3C16 14.3 19 16.4 19 20"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
              />

            </svg>

          </a>

        {%- endif -%}



        <!-- CART -->

        <a
          href="{{ routes.cart_url }}"
          class="pl-header-icon pl-cart-icon"
          aria-label="Cart with {{ cart.item_count }} items"
        >

          <svg
            viewBox="0 0 24 24"
            fill="none"
            aria-hidden="true"
          >

            <path
              d="M4 5H6L8.2 15.4C8.4 16.3 9.1 17 10 17H17.2C18 17 18.7 16.4 18.9 15.6L20.5 9H6.8"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
            />

            <circle
              cx="10"
              cy="20"
              r="1.1"
              fill="currentColor"
            />

            <circle
              cx="17"
              cy="20"
              r="1.1"
              fill="currentColor"
            />

          </svg>


          <span class="pl-cart-count">
            {{ cart.item_count }}
          </span>

        </a>



        <!-- MOBILE MENU -->

        <button
          type="button"
          class="pl-menu-button"
          id="PurelaneMenuButton"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="PurelaneMobileMenu"
        >

          <svg
            viewBox="0 0 24 24"
            fill="none"
            aria-hidden="true"
          >

            <path
              d="M4 8H20"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
            />

            <path
              d="M4 16H20"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
            />

          </svg>

        </button>

      </div>

    </div>



    <!-- =====================================================
         MOBILE NAVIGATION
         ===================================================== -->

    <div
      class="pl-mobile-menu"
      id="PurelaneMobileMenu"
      hidden
    >

      <div class="pl-mobile-menu-inner">

        {%- for block in section.blocks -%}

          {%- if block.type == 'nav_link' -%}

            <a
              href="{{ block.settings.link | default: routes.root_url }}"
              class="pl-mobile-link"
            >
              {{ block.settings.label }}
            </a>

          {%- endif -%}

        {%- endfor -%}

      </div>

    </div>

  </header>

</div>



<style>

/* =========================================================
   PURELANE FLOATING HEADER
   ========================================================= */

.pl-header-wrapper {
  position: fixed;

  top: 24px;
  left: 0;
  right: 0;

  width: 100%;

  z-index: 99999;

  pointer-events: none;

  background: transparent;

  border: 0;
}



/* =========================================================
   MAIN HEADER
   ========================================================= */

.pl-header {

  width: min(1180px, calc(100% - 48px));

  margin: 0 auto;

  position: relative;

  z-index: 1000;

  padding: 0;

  background: transparent;

  border: 0;

  box-shadow: none;

  backdrop-filter: none;

  -webkit-backdrop-filter: none;

  pointer-events: none;
}



/* =========================================================
   CURVED PILL
   ========================================================= */

.pl-header-inner {

  width: 100%;

  min-height: 64px;

  margin: 0 auto;

  display: flex;

  align-items: center;

  padding: 8px 16px;

  border: 1px solid rgba(105, 96, 145, 0.18);

  border-radius: 999px;

  background: rgba(255, 255, 255, 0.78);

  box-shadow:
    0 12px 35px rgba(57, 44, 100, 0.08),
    0 2px 8px rgba(57, 44, 100, 0.04);

  backdrop-filter: blur(18px);

  -webkit-backdrop-filter: blur(18px);

  pointer-events: auto;

  transition:
    background 0.3s ease,
    box-shadow 0.3s ease,
    transform 0.3s ease;

}



/* =========================================================
   BRAND
   ========================================================= */

.pl-brand {

  display: inline-flex;

  align-items: center;

  gap: 10px;

  flex-shrink: 0;

  color: #716d7f;

  text-decoration: none;

}


.pl-brand-mark {

  width: 42px;

  height: 42px;

  display: flex;

  align-items: center;

  justify-content: center;

  border-radius: 50%;

  background: #f8f7f2;

  border: 1px solid rgba(215, 173, 89, 0.3);

  color: #d6a557;

}


.pl-brand-mark svg {

  width: 22px;

  height: 22px;

}


.pl-brand-text {

  display: flex;

  flex-direction: column;

  line-height: 1;

}


.pl-brand-name {

  font-size: 17px;

  font-weight: 800;

  letter-spacing: 0.02em;

  color: #706b7c;

}


.pl-brand-tagline {

  margin-top: 4px;

  font-size: 8px;

  font-weight: 700;

  letter-spacing: 0.28em;

  color: #a7a3b0;

  text-transform: uppercase;

}


.pl-brand-logo {

  display: block;

  width: auto;

  max-width: 150px;

  max-height: 46px;

  object-fit: contain;

}



/* =========================================================
   NAVIGATION
   ========================================================= */

.pl-main-nav {

  flex: 1;

  display: flex;

  align-items: center;

  justify-content: center;

  gap: 30px;

  margin: 0 24px;

}


.pl-nav-link {

  position: relative;

  color: #57536d;

  text-decoration: none;

  font-size: 14px;

  font-weight: 600;

  white-space: nowrap;

  transition:
    color 0.25s ease,
    transform 0.25s ease;

}


.pl-nav-link:hover {

  color: #087c72;

  transform: translateY(-1px);

}



/* =========================================================
   HEADER ACTIONS
   ========================================================= */

.pl-header-actions {

  display: flex;

  align-items: center;

  gap: 7px;

  flex-shrink: 0;

}


.pl-header-icon,
.pl-menu-button {

  position: relative;

  width: 38px;

  height: 38px;

  display: flex;

  align-items: center;

  justify-content: center;

  border: 0;

  border-radius: 50%;

  background: transparent;

  color: #565168;

  text-decoration: none;

  cursor: pointer;

  transition:
    background 0.25s ease,
    color 0.25s ease,
    transform 0.25s ease;

}


.pl-header-icon:hover,
.pl-menu-button:hover {

  background: rgba(100, 88, 145, 0.09);

  color: #087c72;

  transform: translateY(-1px);

}


.pl-header-icon svg,
.pl-menu-button svg {

  width: 20px;

  height: 20px;

}



/* =========================================================
   CART COUNT
   ========================================================= */

.pl-cart-count {

  position: absolute;

  top: -1px;

  right: -1px;

  min-width: 17px;

  height: 17px;

  display: flex;

  align-items: center;

  justify-content: center;

  padding: 0 4px;

  border-radius: 20px;

  background: #51429a;

  color: #ffffff;

  font-size: 9px;

  font-weight: 800;

  line-height: 1;

}



/* =========================================================
   MOBILE MENU BUTTON
   ========================================================= */

.pl-menu-button {

  display: none;

}



/* =========================================================
   MOBILE MENU
   ========================================================= */

.pl-mobile-menu {

  width: min(1180px, calc(100% - 40px));

  margin: 10px auto 0;

  border-radius: 20px;

  background: rgba(255, 255, 255, 0.97);

  border: 1px solid rgba(100, 90, 140, 0.12);

  box-shadow:
    0 20px 50px rgba(50, 40, 90, 0.14);

  pointer-events: auto;

}


.pl-mobile-menu-inner {

  display: flex;

  flex-direction: column;

  padding: 10px;

}


.pl-mobile-link {

  padding: 14px 18px;

  color: #29223e;

  text-decoration: none;

  font-size: 15px;

  font-weight: 650;

  border-radius: 12px;

}


.pl-mobile-link:hover {

  background: #f3f2f8;

  color: #087c72;

}



/* =========================================================
   TABLET
   ========================================================= */

@media screen and (max-width: 900px) {

  .pl-header-wrapper {

    top: 16px;

  }


  .pl-header {

    width: calc(100% - 32px);

  }


  .pl-header-inner {

    min-height: 58px;

  }


  .pl-main-nav {

    gap: 15px;

    margin: 0 12px;

  }


  .pl-nav-link {

    font-size: 12px;

  }


  .pl-brand-name {

    font-size: 15px;

  }

}



/* =========================================================
   MOBILE
   ========================================================= */

@media screen and (max-width: 700px) {

  .pl-header-wrapper {

    top: 12px;

  }


  .pl-header {

    width: calc(100% - 24px);

  }


  .pl-main-nav {

    display: none;

  }


  .pl-account-icon {

    display: none;

  }


  .pl-menu-button {

    display: flex;

  }


  .pl-header-inner {

    padding: 7px 10px;

    min-height: 56px;

  }


  .pl-brand-mark {

    width: 38px;

    height: 38px;

  }


  .pl-brand-logo {

    max-width: 125px;

    max-height: 40px;

  }

}



/* =========================================================
   SMALL MOBILE
   ========================================================= */

@media screen and (max-width: 420px) {

  .pl-header {

    width: calc(100% - 16px);

  }


  .pl-header-inner {

    border-radius: 30px;

  }


  .pl-brand-tagline {

    display: none;

  }


  .pl-header-icon,
  .pl-menu-button {

    width: 34px;

    height: 34px;

  }

}

</style>



<script>

document.addEventListener(
  'DOMContentLoaded',
  function () {

    var button =
      document.getElementById('PurelaneMenuButton');

    var menu =
      document.getElementById('PurelaneMobileMenu');


    if (!button || !menu) {
      return;
    }


    button.addEventListener(
      'click',
      function () {

        var isOpen =
          button.getAttribute('aria-expanded') === 'true';


        button.setAttribute(
          'aria-expanded',
          String(!isOpen)
        );


        button.setAttribute(
          'aria-label',
          isOpen ? 'Open menu' : 'Close menu'
        );


        menu.hidden = isOpen;

      }
    );


    document.addEventListener(
      'keydown',
      function (event) {

        if (event.key === 'Escape') {

          button.setAttribute(
            'aria-expanded',
            'false'
          );


          button.setAttribute(
            'aria-label',
            'Open menu'
          );


          menu.hidden = true;

        }

      }
    );

  }
);

</script>



{% schema %}

{
  "name": "Purelane Header",

  "settings": [

    {
      "type": "header",
      "content": "Brand"
    },

    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },

    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand name",
      "default": "PURELANE"
    },

    {
      "type": "text",
      "id": "brand_tagline",
      "label": "Brand tagline",
      "default": "CLEAN, SIMPLY"
    }

  ],


  "blocks": [

    {
      "type": "nav_link",

      "name": "Navigation link",

      "settings": [

        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Home"
        },

        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }

      ]

    }

  ],


  "max_blocks": 10,


  "presets": [

    {
      "name": "Purelane Header",

      "blocks": [

        {
          "type": "nav_link",

          "settings": {
            "label": "Home",
            "link": "/"
          }

        },

        {
          "type": "nav_link",

          "settings": {
            "label": "Ingredients",
            "link": "#ingredients"
          }

        },

        {
          "type": "nav_link",

          "settings": {
            "label": "How it works",
            "link": "#how"
          }

        },

        {
          "type": "nav_link",

          "settings": {
            "label": "Shop",
            "link": "#shop"
          }

        },

        {
          "type": "nav_link",

          "settings": {
            "label": "Bundles",
            "link": "#bundles"
          }

        }

      ]

    }

  ]

}

{% endschema %}