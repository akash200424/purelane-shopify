<section
  class="sec"
  id="bundles"
  data-scene="3"
>

  <div class="wrap">

    <div
      class="glass sec-pad rv"
      style="margin-bottom:16px"
    >

      <div
        class="panel-head"
        style="margin-bottom:0"
      >

        <span class="kicker">
          {{ section.settings.kicker }}
        </span>

        <h2
          class="d2"
          style="margin-top:12px"
        >
          {{ section.settings.heading }}
        </h2>

        <p class="lede">
          {{ section.settings.description }}
        </p>

      </div>

    </div>


    <div class="tiers">

      {% for block in section.blocks %}

        <article
          class="glass tier {% if block.settings.featured %}best{% endif %} rv {% if forloop.index == 2 %}rv-d2{% elsif forloop.index == 3 %}rv-d3{% endif %}"
          {{ block.shopify_attributes }}
        >

          <span class="tag">
            {{ block.settings.tag }}
          </span>


          <div
            class="tierpix {% if block.settings.product_count == '5' %}five{% endif %}"
            aria-hidden="true"
          >

            {% for product in block.settings.products %}

              {% if product.featured_image %}

                {{
                  product.featured_image
                  | image_url: width: 180
                  | image_tag:
                    class: 'pimg',
                    loading: 'lazy',
                    alt: product.title
                }}

              {% endif %}

            {% endfor %}

          </div>


          <div class="qty">

            {{ block.settings.product_count }}

            <small>
              Products
            </small>

          </div>


          <div class="price">

            {{ block.settings.price }}

            <s>
              {{ block.settings.compare_price }}
            </s>

          </div>


          <p
            class="body-s"
            style="font-size:12px"
          >
            {{ block.settings.price_note }}
          </p>


          <ul>

            {% for i in (1..3) %}

              {% assign feature_key = 'feature_' | append: i %}

              {% if block.settings[feature_key] != blank %}

                <li>

                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.4"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="m5 13 4 4L19 7"/>
                  </svg>

                  {{ block.settings[feature_key] }}

                </li>

              {% endif %}

            {% endfor %}

          </ul>


          <a
            class="btn {% if block.settings.featured %}btn-primary{% else %}btn-ghost{% endif %}"
            href="{{ block.settings.button_link }}"
          >

            {{ block.settings.button_text }}

            {% if block.settings.featured %}

              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M5 12h13m-5-6 6 6-6 6"/>
              </svg>

            {% endif %}

          </a>

        </article>

      {% endfor %}

    </div>

  </div>

</section>


{% schema %}
{
  "name": "Purelane Bundles",
  "max_blocks": 3,
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Build your bundle"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "One box. Every room."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Mix and match across kitchen, laundry, home and skin. One flat price, no code needed, free shipping either way."
    }
  ],
  "blocks": [
    {
      "type": "bundle",
      "name": "Bundle",
      "settings": [
        {
          "type": "text",
          "id": "tag",
          "label": "Tag",
          "default": "Starter"
        },
        {
          "type": "text",
          "id": "product_count",
          "label": "Product count",
          "default": "2"
        },
        {
          "type": "product_list",
          "id": "products",
          "label": "Products",
          "limit": 5
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "₹349"
        },
        {
          "type": "text",
          "id": "compare_price",
          "label": "Compare price",
          "default": "₹598"
        },
        {
          "type": "text",
          "id": "price_note",
          "label": "Price note",
          "default": "Flat ₹174 per product"
        },
        {
          "type": "text",
          "id": "feature_1",
          "label": "Feature 1",
          "default": "Pick any two products"
        },
        {
          "type": "text",
          "id": "feature_2",
          "label": "Feature 2",
          "default": "Free shipping across India"
        },
        {
          "type": "text",
          "id": "feature_3",
          "label": "Feature 3"
        },
        {
          "type": "checkbox",
          "id": "featured",
          "label": "Featured bundle",
          "default": false
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button text",
          "default": "Build this box"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Bundles",
      "blocks": [
        {
          "type": "bundle"
        },
        {
          "type": "bundle",
          "settings": {
            "tag": "Most popular",
            "product_count": "3",
            "price": "₹499",
            "compare_price": "₹897",
            "price_note": "Flat ₹166 per product",
            "feature_1": "Pick any three products",
            "feature_2": "Covers kitchen and laundry",
            "feature_3": "Free shipping across India",
            "featured": true
          }
        },
        {
          "type": "bundle",
          "settings": {
            "tag": "Whole home",
            "product_count": "5",
            "price": "₹799",
            "compare_price": "₹1495",
            "price_note": "Flat ₹160 per product",
            "feature_1": "Pick any five products",
            "feature_2": "Every room in one order",
            "feature_3": "Free shipping across India"
          }
        }
      ]
    }
  ]
}
{% endschema %}