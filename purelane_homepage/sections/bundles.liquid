<section id="bundles" class="pl-bundles-section">

  <div class="pl-bundles-container">

    <!-- HEADER -->
    <div class="pl-bundles-header">

      <p class="pl-bundles-kicker">
        {{ section.settings.kicker }}
      </p>

      <h2 class="pl-bundles-title">
        {{ section.settings.heading }}
      </h2>

      <div class="pl-bundles-divider">
        <span></span>
        <span class="pl-bundles-leaf">⌁</span>
        <span></span>
      </div>

      <p class="pl-bundles-description">
        {{ section.settings.description }}
      </p>

    </div>


    <!-- BUNDLE CARDS -->
    <div class="pl-bundles-grid">

      <!-- STARTER -->
      <article class="pl-bundle-card">

        <div class="pl-bundle-badge">
          STARTER
        </div>

        <div class="pl-bundle-products">

          <div class="pl-bottle pl-bottle-small">
            <span></span>
          </div>

          <div class="pl-bottle pl-bottle-main">
            <span></span>
          </div>

          <div class="pl-bottle pl-bottle-small">
            <span></span>
          </div>

        </div>

        <div class="pl-bundle-count">
          <strong>2</strong>
          <span>PRODUCTS</span>
        </div>

        <div class="pl-bundle-price">
          <strong>₹349</strong>
          <del>₹598</del>
        </div>

        <p class="pl-bundle-per-product">
          Flat ₹174 per product
        </p>

        <ul class="pl-bundle-features">
          <li>Pick any two products</li>
          <li>Free shipping across India</li>
        </ul>

        <a href="#shop" class="pl-bundle-button">
          <span>BUILD THIS BOX</span>
          <span class="pl-bundle-arrow">→</span>
        </a>

      </article>


      <!-- MOST POPULAR -->
      <article class="pl-bundle-card pl-bundle-card-popular">

        <div class="pl-bundle-badge">
          MOST POPULAR
        </div>

        <div class="pl-bundle-products">

          <div class="pl-bottle pl-bottle-main">
            <span></span>
          </div>

          <div class="pl-bottle pl-bottle-main">
            <span></span>
          </div>

          <div class="pl-bottle pl-bottle-main">
            <span></span>
          </div>

        </div>

        <div class="pl-bundle-count">
          <strong>3</strong>
          <span>PRODUCTS</span>
        </div>

        <div class="pl-bundle-price">
          <strong>₹499</strong>
          <del>₹897</del>
        </div>

        <p class="pl-bundle-per-product">
          Flat ₹166 per product
        </p>

        <ul class="pl-bundle-features">
          <li>Pick any three products</li>
          <li>Covers kitchen and laundry</li>
          <li>Free shipping across India</li>
        </ul>

        <a href="#shop" class="pl-bundle-button pl-bundle-button-primary">
          <span>BUILD THIS BOX</span>
          <span class="pl-bundle-arrow">→</span>
        </a>

      </article>


      <!-- WHOLE HOME -->
      <article class="pl-bundle-card">

        <div class="pl-bundle-badge">
          WHOLE HOME
        </div>

        <div class="pl-bundle-products">

          <div class="pl-bottle pl-bottle-small">
            <span></span>
          </div>

          <div class="pl-bottle pl-bottle-small">
            <span></span>
          </div>

          <div class="pl-bottle pl-bottle-small">
            <span></span>
          </div>

          <div class="pl-bottle pl-bottle-small">
            <span></span>
          </div>

          <div class="pl-bottle pl-bottle-small">
            <span></span>
          </div>

        </div>

        <div class="pl-bundle-count">
          <strong>5</strong>
          <span>PRODUCTS</span>
        </div>

        <div class="pl-bundle-price">
          <strong>₹799</strong>
          <del>₹1,495</del>
        </div>

        <p class="pl-bundle-per-product">
          Flat ₹160 per product
        </p>

        <ul class="pl-bundle-features">
          <li>Pick any five products</li>
          <li>Every room in one order</li>
          <li>Free shipping across India</li>
        </ul>

        <a href="#shop" class="pl-bundle-button">
          <span>BUILD THIS BOX</span>
          <span class="pl-bundle-arrow">→</span>
        </a>

      </article>

    </div>

  </div>

</section>


{% schema %}
{
  "name": "Bundles",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Build your bundle"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "One box. Every room."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Mix and match across kitchen, laundry, home and skin. One flat price, no code needed, free shipping either way."
    }
  ],
  "presets": [
    {
      "name": "Bundles"
    }
  ]
}
{% endschema %}