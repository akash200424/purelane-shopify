<section
  id="bundles"
  class="pl-bundles-section"
>

  <div class="pl-bundles-container">

    <!-- =========================
         HEADER
    ========================== -->

    <div class="pl-bundles-header">

      {% if section.settings.kicker != blank %}
        <p class="pl-bundles-kicker">
          {{ section.settings.kicker }}
        </p>
      {% endif %}


      {% if section.settings.heading != blank %}
        <h2 class="pl-bundles-title">
          {{ section.settings.heading }}
        </h2>
      {% endif %}


      <div class="pl-bundles-divider">

        <span></span>

        <span class="pl-bundles-leaf">
          ⌁
        </span>

        <span></span>

      </div>


      {% if section.settings.description != blank %}
        <p class="pl-bundles-description">
          {{ section.settings.description }}
        </p>
      {% endif %}

    </div>


    <!-- =========================
         BUNDLE CARDS
    ========================== -->

    {% assign bundle_blocks = section.blocks | where: 'type', 'bundle' %}

    {% if bundle_blocks.size > 0 %}

      <div class="pl-bundles-grid">

        {% for block in bundle_blocks %}

          <article
            class="
              pl-bundle-card
              {% if block.settings.featured %}
                pl-bundle-card-popular
              {% endif %}
            "
            {{ block.shopify_attributes }}
          >

            <!-- BADGE -->

            {% if block.settings.badge != blank %}

              <div class="pl-bundle-badge">
                {{ block.settings.badge }}
              </div>

            {% endif %}


            <!-- =========================
                 BUNDLE IMAGE
            ========================== -->

            {% if block.settings.bundle_image != blank %}

              <div class="pl-bundle-products">

                {{
                  block.settings.bundle_image
                  | image_url: width: 700
                  | image_tag:
                    loading: 'lazy',
                    alt: block.settings.image_alt
                }}

              </div>

            {% endif %}


            <!-- =========================
                 PRODUCT COUNT
            ========================== -->

            {% if block.settings.product_count != blank %}

              <div class="pl-bundle-count">

                <strong>
                  {{ block.settings.product_count }}
                </strong>

                <span>
                  {{ block.settings.product_count_label }}
                </span>

              </div>

            {% endif %}


            <!-- =========================
                 PRICE
            ========================== -->

            <div class="pl-bundle-price">

              {% if block.settings.price != blank %}

                <strong>
                  {{ block.settings.price }}
                </strong>

              {% endif %}


              {% if block.settings.compare_price != blank %}

                <del>
                  {{ block.settings.compare_price }}
                </del>

              {% endif %}

            </div>


            <!-- PER PRODUCT -->

            {% if block.settings.per_product != blank %}

              <p class="pl-bundle-per-product">
                {{ block.settings.per_product }}
              </p>

            {% endif %}


            <!-- =========================
                 FEATURES
            ========================== -->

            {% assign features = block.settings.features | newline_to_br | split: '<br />' %}

            {% if block.settings.features != blank %}

              <ul class="pl-bundle-features">

                {% for feature in features %}

                  {% assign clean_feature = feature | strip %}

                  {% if clean_feature != blank %}

                    <li>
                      {{ clean_feature }}
                    </li>

                  {% endif %}

                {% endfor %}

              </ul>

            {% endif %}


            <!-- =========================
                 BUTTON
            ========================== -->

            {% if block.settings.button_text != blank %}

              <a
                href="{{ block.settings.button_link | default: '#shop' }}"
                class="
                  pl-bundle-button
                  {% if block.settings.featured %}
                    pl-bundle-button-primary
                  {% endif %}
                "
              >

                <span>
                  {{ block.settings.button_text }}
                </span>

                <span class="pl-bundle-arrow">
                  →
                </span>

              </a>

            {% endif %}

          </article>

        {% endfor %}

      </div>

    {% endif %}

  </div>

</section>

<style>
  .pl-bundle-products {
    width: 100%;
    height: 190px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .pl-bundle-products img {
    width: 94%;
    height: 94%;
    object-fit: contain;
    object-position: center;
    display: block;
  }

  @media screen and (max-width: 749px) {
    .pl-bundle-products {
      height: 150px;
    }

    .pl-bundle-products img {
      width: 94%;
      height: 94%;
    }
  }
</style>


{% schema %}

{
  "name": "Bundles",

  "settings": [

    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Build your bundle"
    },

    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "One box. Every room."
    },

    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Mix and match across kitchen, laundry, home and skin. One flat price, no code needed, free shipping either way."
    }

  ],


  "blocks": [

    {
      "type": "bundle",

      "name": "Bundle",

      "settings": [

        {
          "type": "header",
          "content": "Bundle appearance"
        },

        {
          "type": "text",
          "id": "badge",
          "label": "Badge",
          "default": "STARTER"
        },

        {
          "type": "checkbox",
          "id": "featured",
          "label": "Featured / popular bundle",
          "default": false
        },


        {
          "type": "header",
          "content": "Bundle image"
        },

        {
          "type": "image_picker",
          "id": "bundle_image",
          "label": "Bundle image"
        },

        {
          "type": "text",
          "id": "image_alt",
          "label": "Image alt text",
          "default": "Bundle products"
        },


        {
          "type": "header",
          "content": "Bundle details"
        },

        {
          "type": "text",
          "id": "product_count",
          "label": "Product count",
          "default": "2"
        },

        {
          "type": "text",
          "id": "product_count_label",
          "label": "Product count label",
          "default": "PRODUCTS"
        },


        {
          "type": "header",
          "content": "Pricing"
        },

        {
          "type": "text",
          "id": "price",
          "label": "Bundle price",
          "default": "₹349"
        },

        {
          "type": "text",
          "id": "compare_price",
          "label": "Original price",
          "default": "₹598"
        },

        {
          "type": "text",
          "id": "per_product",
          "label": "Price per product",
          "default": "Flat ₹174 per product"
        },


        {
          "type": "header",
          "content": "Features"
        },

        {
          "type": "textarea",
          "id": "features",
          "label": "Features",
          "info": "Enter one feature per line.",
          "default": "Pick any two products\nFree shipping across India"
        },


        {
          "type": "header",
          "content": "Button"
        },

        {
          "type": "text",
          "id": "button_text",
          "label": "Button text",
          "default": "BUILD THIS BOX"
        },

        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }

      ]

    }

  ],


  "presets": [

    {
      "name": "Bundles",

      "blocks": [

        {
          "type": "bundle",

          "settings": {

            "badge": "STARTER",

            "featured": false,

            "product_count": "2",

            "product_count_label": "PRODUCTS",

            "price": "₹349",

            "compare_price": "₹598",

            "per_product": "Flat ₹174 per product",

            "features": "Pick any two products\nFree shipping across India",

            "button_text": "BUILD THIS BOX",

            "button_link": "#shop"

          }

        },


        {
          "type": "bundle",

          "settings": {

            "badge": "MOST POPULAR",

            "featured": true,

            "product_count": "3",

            "product_count_label": "PRODUCTS",

            "price": "₹499",

            "compare_price": "₹897",

            "per_product": "Flat ₹166 per product",

            "features": "Pick any three products\nCovers kitchen and laundry\nFree shipping across India",

            "button_text": "BUILD THIS BOX",

            "button_link": "#shop"

          }

        },


        {
          "type": "bundle",

          "settings": {

            "badge": "WHOLE HOME",

            "featured": false,

            "product_count": "5",

            "product_count_label": "PRODUCTS",

            "price": "₹799",

            "compare_price": "₹1,495",

            "per_product": "Flat ₹160 per product",

            "features": "Pick any five products\nEvery room in one order\nFree shipping across India",

            "button_text": "BUILD THIS BOX",

            "button_link": "#shop"

          }

        }

      ]

    }

  ]

}

{% endschema %}