<a
  id="how-it-works"
  class="purelane-anchor"
  aria-hidden="true"
></a>
<section
  id="why-it-works-{{ section.id }}"
  class="why-works-section"
  data-nav-section="how-it-works"
>

  <div class="why-works">

    <div class="why-works-inner">

      <!-- =====================================================
           LEFT CONTENT
           ===================================================== -->

      <div class="why-works-content">

        {% if section.settings.eyebrow != blank %}
          <span class="why-works-eyebrow">
            {{ section.settings.eyebrow }}
          </span>
        {% endif %}


        {% if section.settings.heading != blank %}
          <h2>
            {{ section.settings.heading | newline_to_br }}
          </h2>
        {% endif %}


        {% if section.settings.description != blank %}
          <p>
            {{ section.settings.description }}
          </p>
        {% endif %}


        {% if section.settings.button_text != blank %}
          <a
            href="{{ section.settings.button_link | default: '#' }}"
            class="why-works-button"
          >
            <span>
              {{ section.settings.button_text }}
            </span>

            <span
              class="why-works-arrow"
              aria-hidden="true"
            >
              →
            </span>
          </a>
        {% endif %}

      </div>


      <!-- =====================================================
           RIGHT PRODUCT SLIDER
           ===================================================== -->

      <div class="why-works-product">

        <div
          class="why-product-glow"
          aria-hidden="true"
        ></div>


        <div class="why-product-card">

          {% assign product_slide_blocks =
            section.blocks | where: 'type', 'product_slide'
          %}


          {% if product_slide_blocks.size > 0 %}

            <div
              class="why-product-slides"
              data-slider
            >

              {% for block in product_slide_blocks %}

                <div
                  class="
                    why-product-slide
                    {% if forloop.first %}active{% endif %}
                  "
                  data-slide-index="{{ forloop.index0 }}"
                  {{ block.shopify_attributes }}
                >

                  <!-- PRODUCT IMAGE -->

                  {% if block.settings.image != blank %}

                    <div class="why-product-image-wrap">

                      {{
                        block.settings.image
                        | image_url: width: 900
                        | image_tag:
                          loading: 'lazy',
                          widths: '300,500,700,900',
                          sizes: '(max-width: 550px) 80vw, 400px',
                          class: 'why-product-image',
                          alt: block.settings.title
                      }}

                    </div>

                  {% endif %}


                  <!-- PRODUCT TITLE -->

                  {% if block.settings.title != blank %}

                    <strong class="why-product-name">
                      {{ block.settings.title }}
                    </strong>

                  {% endif %}


                  <!-- PRODUCT DESCRIPTION -->

                  {% if block.settings.description != blank %}

                    <span class="why-product-description">
                      {{ block.settings.description }}
                    </span>

                  {% endif %}

                </div>

              {% endfor %}

            </div>


            <!-- =================================================
                 DOTS
                 ================================================= -->

            {% if product_slide_blocks.size > 1 %}

              <div
                class="why-product-dots"
                aria-label="Product slides"
              >

                {% for block in product_slide_blocks %}

                  <button
                    type="button"
                    class="
                      why-dot
                      {% if forloop.first %}active{% endif %}
                    "
                    data-slide="{{ forloop.index0 }}"
                    aria-label="Show product {{ forloop.index }}"
                  ></button>

                {% endfor %}

              </div>

            {% endif %}


          {% else %}

            <!-- EMPTY STATE -->

            <div class="why-product-empty">

              <span>
                Add Product Image blocks
              </span>

            </div>

          {% endif %}

        </div>

      </div>

    </div>


    <!-- =====================================================
         STATS
         ===================================================== -->

    {% assign stat_blocks =
      section.blocks | where: 'type', 'stat'
    %}


    {% if stat_blocks.size > 0 %}

      <div class="why-works-stats">

        {% for block in stat_blocks %}

          <div
            class="why-stat"
            {{ block.shopify_attributes }}
          >

            {% if block.settings.number != blank %}

              <strong>
                {{ block.settings.number }}
              </strong>

            {% endif %}


            {% if block.settings.label != blank %}

              <span>
                {{ block.settings.label }}
              </span>

            {% endif %}


            {% if block.settings.description != blank %}

              <p>
                {{ block.settings.description }}
              </p>

            {% endif %}

          </div>

        {% endfor %}

      </div>

    {% endif %}

  </div>

</section>


<style>

/* =========================================================
   MAIN SECTION
   ========================================================= */

#why-it-works-{{ section.id }} {
  width: 100%;
  padding: 40px 0;
  box-sizing: border-box;
}


/* =========================================================
   MAIN GLASS CARD
   ========================================================= */

#why-it-works-{{ section.id }} .why-works {

  width: min(
    1140px,
    calc(100% - 32px)
  );

  margin: 70px auto;

  padding: 48px 40px 40px;

  box-sizing: border-box;

  border-radius: 28px;

  background:
    linear-gradient(
      135deg,
      rgba(255,255,255,.82),
      rgba(232,247,241,.76)
    );

  border: 1px solid rgba(
    255,
    255,
    255,
    .92
  );

  box-shadow:
    0 20px 55px rgba(
      30,
      30,
      70,
      .07
    );

  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);

}


/* =========================================================
   TWO COLUMN LAYOUT
   ========================================================= */

#why-it-works-{{ section.id }} .why-works-inner {

  display: grid;

  grid-template-columns:
    1.05fr .95fr;

  align-items: center;

  gap: 45px;

}


/* =========================================================
   LEFT CONTENT
   ========================================================= */

#why-it-works-{{ section.id }} .why-works-content {

  padding: 5px 0;

}


#why-it-works-{{ section.id }} .why-works-eyebrow {

  display: block;

  margin-bottom: 18px;

  color: #aaa8b9;

  font-size: 12px;

  font-weight: 800;

  letter-spacing: .20em;

  line-height: 1.2;

}


#why-it-works-{{ section.id }} .why-works-content h2 {

  margin: 0;

  color: #19142f;

  font-size:
    clamp(
      42px,
      4vw,
      58px
    );

  line-height: .93;

  letter-spacing: -.045em;

  font-weight: 900;

  text-transform: uppercase;

}


#why-it-works-{{ section.id }} .why-works-content p {

  max-width: 470px;

  margin: 25px 0 28px;

  color: #6b6c81;

  font-size: 15px;

  line-height: 1.65;

}


/* =========================================================
   BUTTON
   ========================================================= */

#why-it-works-{{ section.id }} .why-works-button {

  display: inline-flex;

  align-items: center;

  gap: 18px;

  padding: 14px 22px;

  border-radius: 999px;

  background: #087d74;

  color: #fff;

  text-decoration: none;

  font-size: 12px;

  font-weight: 900;

  letter-spacing: .12em;

  box-shadow:
    0 10px 24px
    rgba(8,125,116,.18);

  transition:
    transform .3s ease,
    background .3s ease,
    box-shadow .3s ease;

}


#why-it-works-{{ section.id }} .why-works-arrow {

  font-size: 18px;

  line-height: 1;

  letter-spacing: 0;

}


#why-it-works-{{ section.id }} .why-works-button:hover {

  background: #06655f;

  transform: translateY(-2px);

  box-shadow:
    0 14px 30px
    rgba(8,125,116,.25);

}


/* =========================================================
   RIGHT PRODUCT AREA
   ========================================================= */

#why-it-works-{{ section.id }} .why-works-product {

  position: relative;

  min-height: 330px;

  display: flex;

  align-items: center;

  justify-content: center;

}


/* =========================================================
   GLOW
   ========================================================= */

#why-it-works-{{ section.id }} .why-product-glow {

  position: absolute;

  width: 270px;

  height: 270px;

  border-radius: 50%;

  background:
    radial-gradient(
      circle,
      rgba(125,110,210,.20),
      transparent 68%
    );

  filter: blur(10px);

  animation:
    whyGlow-{{ section.id }}
    4s
    ease-in-out
    infinite;

}


@keyframes whyGlow-{{ section.id }} {

  0%,
  100% {

    transform: scale(.95);

    opacity: .6;

  }

  50% {

    transform: scale(1.08);

    opacity: 1;

  }

}


/* =========================================================
   PRODUCT CARD
   ========================================================= */

#why-it-works-{{ section.id }} .why-product-card {

  position: relative;

  width: 100%;

  max-width: 435px;

  height: 315px;

  display: flex;

  align-items: center;

  justify-content: center;

  border-radius: 24px;

  background:
    radial-gradient(
      circle,
      rgba(255,255,255,.98),
      rgba(245,244,250,.82)
    );

  border: 1px solid
    rgba(220,220,235,.8);

  overflow: hidden;

  z-index: 2;

}


/* =========================================================
   SLIDER
   ========================================================= */

#why-it-works-{{ section.id }} .why-product-slides {

  position: relative;

  width: 100%;

  height: 100%;

}
.purelane-anchor {
  display: block;
  position: relative;
  top: -110px;
  visibility: hidden;
}


/* =========================================================
   INDIVIDUAL SLIDE
   ========================================================= */

#why-it-works-{{ section.id }} .why-product-slide {

  position: absolute;

  inset: 0;

  display: flex;

  flex-direction: column;

  align-items: center;

  justify-content: center;

  opacity: 0;

  visibility: hidden;

  pointer-events: none;

  transform:
    translateX(35px)
    translateY(15px)
    scale(.96);

  transition:
    opacity .7s ease,
    transform .7s
      cubic-bezier(.22,.61,.36,1),
    visibility .7s ease;

}


/* ACTIVE */

#why-it-works-{{ section.id }} .why-product-slide.active {

  opacity: 1;

  visibility: visible;

  pointer-events: auto;

  transform:
    translateX(0)
    translateY(0)
    scale(1);

}


/* =========================================================
   IMAGE WRAPPER
   ========================================================= */

#why-it-works-{{ section.id }} .why-product-image-wrap {

  width: 100%;

  height: 215px;

  display: flex;

  align-items: center;

  justify-content: center;

  overflow: hidden;

}


/* =========================================================
   DYNAMIC SHOPIFY IMAGE
   ========================================================= */

#why-it-works-{{ section.id }} .why-product-image {

  display: block;

  width: auto;

  max-width: 260px;

  height: 210px;

  max-height: 210px;

  object-fit: contain;

  object-position: center;

  margin-top: -8px;

  filter:
    drop-shadow(
      0 25px 25px
      rgba(50,40,100,.18)
    );

  user-select: none;

  -webkit-user-drag: none;

  animation:
    whyBottleFloat-{{ section.id }}
    3.8s
    ease-in-out
    infinite;

}


/* =========================================================
   BOTTLE FLOAT ANIMATION
   ========================================================= */

@keyframes whyBottleFloat-{{ section.id }} {

  0%,
  100% {

    transform:
      translateY(0)
      rotate(0deg);

  }

  25% {

    transform:
      translateY(-6px)
      rotate(-1deg);

  }

  50% {

    transform:
      translateY(-12px)
      rotate(0deg);

  }

  75% {

    transform:
      translateY(-6px)
      rotate(1deg);

  }

}


/* =========================================================
   PRODUCT TITLE
   ========================================================= */

#why-it-works-{{ section.id }} .why-product-name {

  margin-top: 0;

  color: #242039;

  font-size: 12px;

  line-height: 1.2;

  font-weight: 900;

  letter-spacing: .08em;

  text-transform: uppercase;

}


/* =========================================================
   PRODUCT DESCRIPTION
   ========================================================= */

#why-it-works-{{ section.id }} .why-product-description {

  margin-top: 7px;

  color: #9693a6;

  font-size: 11px;

  line-height: 1.3;

  text-align: center;

}


/* =========================================================
   DOTS
   ========================================================= */

#why-it-works-{{ section.id }} .why-product-dots {

  position: absolute;

  bottom: 14px;

  left: 50%;

  transform: translateX(-50%);

  display: flex;

  align-items: center;

  gap: 5px;

  z-index: 10;

}


#why-it-works-{{ section.id }} .why-dot {

  width: 6px;

  height: 6px;

  padding: 0;

  border: 0;

  border-radius: 50%;

  background: #c9c4dc;

  cursor: pointer;

  opacity: .9;

  transition:
    width .3s ease,
    background .3s ease,
    opacity .3s ease;

}


#why-it-works-{{ section.id }} .why-dot:hover {

  opacity: 1;

}


#why-it-works-{{ section.id }} .why-dot.active {

  width: 19px;

  border-radius: 999px;

  background: #d38a16;

}


/* =========================================================
   EMPTY STATE
   ========================================================= */

#why-it-works-{{ section.id }} .why-product-empty {

  width: 100%;

  height: 100%;

  display: flex;

  align-items: center;

  justify-content: center;

  color: #aaa8b9;

  font-size: 12px;

  font-weight: 700;

  letter-spacing: .08em;

  text-transform: uppercase;

}


/* =========================================================
   STATS
   ========================================================= */

#why-it-works-{{ section.id }} .why-works-stats {

  margin-top: 35px;

  padding: 20px 12px;

  display: grid;

  grid-template-columns:
    repeat(4, 1fr);

  border-radius: 24px;

  background:
    rgba(255,255,255,.72);

  border: 1px solid
    rgba(255,255,255,.85);

}


#why-it-works-{{ section.id }} .why-stat {

  position: relative;

  text-align: center;

  padding: 0 20px;

}


#why-it-works-{{ section.id }}
.why-stat:not(:last-child)::after {

  content: "";

  position: absolute;

  right: 0;

  top: 5px;

  width: 1px;

  height: 80px;

  background: #dddbea;

}


#why-it-works-{{ section.id }} .why-stat strong {

  width: 70px;

  height: 70px;

  margin: 0 auto 12px;

  display: flex;

  align-items: center;

  justify-content: center;

  border-radius: 50%;

  background: #fff;

  border: 1px solid #ddd8ed;

  color: #211b3b;

  font-size: 17px;

  line-height: 1;

  font-weight: 900;

}


#why-it-works-{{ section.id }} .why-stat span {

  display: block;

  margin-bottom: 7px;

  color: #c87910;

  font-size: 10px;

  line-height: 1.2;

  font-weight: 900;

  letter-spacing: .15em;

}


#why-it-works-{{ section.id }} .why-stat p {

  margin: 0;

  color: #77788b;

  font-size: 11px;

  line-height: 1.4;

}


/* =========================================================
   TABLET
   ========================================================= */

@media (max-width: 850px) {

  #why-it-works-{{ section.id }} .why-works {

    padding: 35px 25px;

  }


  #why-it-works-{{ section.id }}
  .why-works-inner {

    grid-template-columns: 1fr;

    gap: 30px;

  }


  #why-it-works-{{ section.id }}
  .why-works-product {

    min-height: 300px;

  }


  #why-it-works-{{ section.id }}
  .why-works-stats {

    grid-template-columns:
      repeat(2, 1fr);

    gap: 25px;

  }


  #why-it-works-{{ section.id }}
  .why-stat:nth-child(2)::after {

    display: none;

  }

}


/* =========================================================
   MOBILE
   ========================================================= */

@media (max-width: 550px) {

  #why-it-works-{{ section.id }} {

    padding: 25px 0;

  }


  #why-it-works-{{ section.id }} .why-works {

    width: calc(100% - 20px);

    margin: 45px auto;

    padding: 30px 18px;

    border-radius: 22px;

  }


  #why-it-works-{{ section.id }}
  .why-works-content h2 {

    font-size: 38px;

  }


  #why-it-works-{{ section.id }}
  .why-product-card {

    height: 290px;

  }


  #why-it-works-{{ section.id }}
  .why-product-image {

    max-width: 210px;

    height: 190px;

    max-height: 190px;

  }


  #why-it-works-{{ section.id }}
  .why-product-image-wrap {

    height: 195px;

  }


  #why-it-works-{{ section.id }}
  .why-works-stats {

    grid-template-columns:
      1fr 1fr;

    gap: 25px 0;

  }


  #why-it-works-{{ section.id }}
  .why-stat {

    padding: 0 8px;

  }

}


/* =========================================================
   REDUCED MOTION
   ========================================================= */

@media (prefers-reduced-motion: reduce) {

  #why-it-works-{{ section.id }}
  .why-product-glow,

  #why-it-works-{{ section.id }}
  .why-product-image {

    animation: none !important;

  }


  #why-it-works-{{ section.id }}
  .why-product-slide {

    transition: none !important;

  }

}

</style>


<script>

(function() {

  function initWhyWorks(section) {

    if (!section) {
      return;
    }


    const slides =
      section.querySelectorAll(
        '.why-product-slide'
      );

    const dots =
      section.querySelectorAll(
        '.why-dot'
      );


    /*
      Only one image:
      no animation required.
    */

    if (slides.length <= 1) {
      return;
    }


    let current = 0;

    let timer = null;


    /*
      Animation speed comes
      directly from Theme Editor.
    */

    const speed = Math.max(
      Number(
        section.dataset.animationSpeed || 4000
      ),
      2000
    );


    /*
      SHOW SLIDE
    */

    function showSlide(index) {

      current =
        (index + slides.length)
        % slides.length;


      slides.forEach(
        function(slide, i) {

          slide.classList.toggle(
            'active',
            i === current
          );

        }
      );


      dots.forEach(
        function(dot, i) {

          dot.classList.toggle(
            'active',
            i === current
          );

        }
      );

    }


    /*
      START AUTOMATIC ANIMATION
    */

    function startTimer() {

      clearInterval(timer);


      timer = setInterval(
        function() {

          showSlide(
            current + 1
          );

        },
        speed
      );

    }


    /*
      DOT CLICK
    */

    dots.forEach(
      function(dot) {

        dot.addEventListener(
          'click',
          function() {

            const index =
              Number(
                this.dataset.slide
              );

            showSlide(index);

            startTimer();

          }
        );

      }
    );


    /*
      INITIAL
    */

    showSlide(0);

    startTimer();


    /*
      PAUSE WHEN MOUSE IS OVER
      PRODUCT CARD
    */

    const card =
      section.querySelector(
        '.why-product-card'
      );


    if (card) {

      card.addEventListener(
        'mouseenter',
        function() {

          clearInterval(timer);

        }
      );


      card.addEventListener(
        'mouseleave',
        function() {

          startTimer();

        }
      );

    }

  }


  /*
    NORMAL PAGE LOAD
  */

  function initAll() {

    document
      .querySelectorAll(
        '.why-works-section'
      )
      .forEach(
        function(section) {

          /*
            Put animation speed
            from Liquid into DOM.
          */

          section.dataset.animationSpeed =
            {{ section.settings.animation_speed | default: 4000 | json }};


          initWhyWorks(section);

        }
      );

  }


  if (
    document.readyState ===
    'loading'
  ) {

    document.addEventListener(
      'DOMContentLoaded',
      initAll
    );

  } else {

    initAll();

  }


  /*
    SHOPIFY THEME EDITOR
  */

  document.addEventListener(
    'shopify:section:load',
    function(event) {

      const section =
        event.target.querySelector
          ? event.target.querySelector(
              '.why-works-section'
            )
          : null;


      if (section) {

        section.dataset.animationSpeed =
          {{ section.settings.animation_speed | default: 4000 | json }};


        initWhyWorks(section);

      }

    }
  );


})();

</script>


