<section class="purelane-how">

  <div class="purelane-how__inner">

    <!-- LEFT CONTENT -->
    <div class="purelane-how__content">

      <span class="purelane-how__kicker">
        WHY IT WORKS
      </span>

      <h2 class="purelane-how__heading">
        TOUGH ON GRIME.<br>
        GENTLE ON<br>
        EVERYTHING ELSE.
      </h2>

      <p class="purelane-how__description">
        Every formula is built on plant-derived cleansers and
        essential oils. It behaves exactly like the cleaner you
        are used to, minus the things you never signed up for.
      </p>

      <a
        href="/pages/ingredients"
        class="purelane-how__button"
      >
        SEE THE INGREDIENT LIST
        <span>→</span>
      </a>

    </div>


    <!-- RIGHT PRODUCT CARD -->
    <div class="purelane-how__product">

      <div class="purelane-how__bottle">

        <div class="purelane-bottle">
          <div class="purelane-bottle__cap"></div>

          <div class="purelane-bottle__body">

            <div class="purelane-bottle__label">
              <span></span>
              <span></span>
            </div>

          </div>
        </div>

      </div>

      <h3>TOILET CLEANER</h3>

      <p>Kills 99.9% of germs</p>

      <div class="purelane-how__dots">
        <i></i>
        <i></i>
        <i></i>
        <i class="active"></i>
        <i></i>
        <i></i>
      </div>

    </div>


    <!-- STATISTICS -->
    <div class="purelane-how__stats">

      <div class="purelane-how__stat">

        <div class="purelane-how__circle">
          99.9%
        </div>

        <strong>GERM KILL</strong>

        <p>
          Tested against germs and bacteria
        </p>

      </div>


      <div class="purelane-how__stat">

        <div class="purelane-how__circle">
          0%
        </div>

        <strong>SULPHATES</strong>

        <p>
          No SLS, chlorine or parabens
        </p>

      </div>


      <div class="purelane-how__stat">

        <div class="purelane-how__circle">
          100%
        </div>

        <strong>PLANT BASED</strong>

        <p>
          Cleansers derived from plants
        </p>

      </div>


      <div class="purelane-how__stat">

        <div class="purelane-how__circle">
          4.8
        </div>

        <strong>RATED</strong>

        <p>
          Across 8,000+ verified reviews
        </p>

      </div>

    </div>

  </div>

</section>


{% schema %}
{
  "name": "How It Works",
  "settings": [],
  "presets": [
    {
      "name": "How It Works"
    }
  ]
}
{% endschema %}